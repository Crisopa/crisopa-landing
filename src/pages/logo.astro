---
import Layout from '../layouts/Layout.astro'
---

<Layout title="crisopa" description="La historia detrás de crisopa">
  <div class="page-wrapper bg-background overflow-x-hidden">
    <!-- Hero -->
    <section class="hero min-h-screen flex flex-col items-center justify-center relative">
      <div class="logo-container flex flex-col items-center gap-8 relative z-10">
        <div class="icon-wrapper">
          <svg
            class="logo-icon w-28 h-28 md:w-40 md:h-40 text-primary-600"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path class="path-main" d="M11.264 2.205A4 4 0 0 0 6.42 4.211l-4 8a4 4 0 0 0 1.359 5.117l6 4a4 4 0 0 0 4.438 0l6-4a4 4 0 0 0 1.576-4.592l-2-6a4 4 0 0 0-2.53-2.53z"/>
            <path class="path-detail" d="M11.99 22 14 12l7.822 3.184"/>
            <path class="path-detail" d="M14 12 8.47 2.302"/>
          </svg>
        </div>

        <h1 class="logo-text font-logo text-6xl md:text-8xl text-foreground">
          crisopa
        </h1>
      </div>

      <!-- Scroll cue -->
      <div class="scroll-cue absolute bottom-12">
        <div class="mouse"></div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="story-section min-h-screen flex items-center justify-center py-32 relative">
      <div class="story-card max-w-3xl mx-6 p-12 md:p-16 text-center">
        <p class="reveal text-sm uppercase tracking-[0.3em] text-primary-700 mb-8 font-medium">
          El nombre
        </p>

        <h2 class="reveal text-3xl md:text-5xl text-foreground mb-8">
          Un depredador que<br>
          <span class="text-primary-700">protege lo que importa</span>
        </h2>

        <p class="reveal text-lg md:text-xl text-foreground-muted leading-relaxed">
          La <i>Chrysopa</i> es un insecto que devora las plagas del campo.
          Sin químicos. Sin ruido. Solo resultados.
        </p>

        <div class="reveal mt-12 flex items-center justify-center gap-8">
          <div class="stat">
            <span class="font-data text-4xl md:text-5xl font-medium tabular-nums text-primary-700">200+</span>
            <span class="text-sm text-foreground-muted block mt-1">pulgones/día</span>
          </div>
          <div class="w-px h-16 bg-line"></div>
          <div class="stat">
            <span class="font-data text-4xl md:text-5xl font-medium tabular-nums text-primary-700">0</span>
            <span class="text-sm text-foreground-muted block mt-1">químicos</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Symbol Section -->
    <section class="symbol-section min-h-screen flex items-center justify-center py-32 relative">
      <div class="max-w-5xl mx-6 w-full">
        <div class="text-center mb-16">
          <p class="reveal text-sm uppercase tracking-[0.3em] text-primary-700 mb-4 font-medium">
            El logotipo
          </p>
          <h2 class="reveal text-3xl md:text-5xl text-foreground">
            Múltiples lecturas, un propósito
          </h2>
        </div>

        <div class="reveal flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-16">
          <!-- Logo showcase -->
          <div class="logo-showcase-card flex-shrink-0">
            <svg
              class="w-32 h-32 md:w-40 md:h-40 text-primary-600"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M11.264 2.205A4 4 0 0 0 6.42 4.211l-4 8a4 4 0 0 0 1.359 5.117l6 4a4 4 0 0 0 4.438 0l6-4a4 4 0 0 0 1.576-4.592l-2-6a4 4 0 0 0-2.53-2.53z"/>
              <path d="M11.99 22 14 12l7.822 3.184"/>
              <path d="M14 12 8.47 2.302"/>
            </svg>
          </div>

          <!-- Interpretations -->
          <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-4">
            <div class="symbol-card-mini">
              <div class="symbol-icon-mini">🦋</div>
              <div>
                <h3 class="text-lg text-foreground">Crisálida</h3>
                <p class="text-foreground-muted text-sm">Transformación constante</p>
              </div>
            </div>

            <div class="symbol-card-mini">
              <div class="symbol-icon-mini">🪨</div>
              <div>
                <h3 class="text-lg text-foreground">Roca</h3>
                <p class="text-foreground-muted text-sm">Solidez y confianza</p>
              </div>
            </div>

            <div class="symbol-card-mini">
              <div class="symbol-icon-mini">💎</div>
              <div>
                <h3 class="text-lg text-foreground">Gema</h3>
                <p class="text-foreground-muted text-sm">Valor en cada detalle</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Name Section -->
    <section class="name-section min-h-screen flex items-center justify-center py-32 relative">
      <div class="max-w-4xl mx-6 text-center">
        <p class="reveal text-sm uppercase tracking-[0.3em] text-primary-700 mb-8 font-medium">
          El nombre
        </p>

        <h2 class="reveal text-5xl md:text-8xl text-foreground mb-12" id="crisopa-name">
          <span>c</span><span>r</span><span class="letter-interactive" data-letter="i">i</span><span>s</span><span>o</span><span class="letter-interactive" data-letter="p">p</span><span>a</span>
        </h2>

        <!-- Easter egg message -->
        <div id="founders-reveal" class="founders-message mb-12">
          <p class="text-lg md:text-xl text-foreground-muted">
            Los socios. <span class="text-primary-700 font-semibold">Ignacio</span> y <span class="text-primary-700 font-semibold">Pablo</span>.
          </p>
          <p class="text-2xl md:text-3xl font-semibold text-foreground mt-2">
            Unos depredadores.
          </p>
        </div>

        <div class="reveal inline-flex flex-wrap justify-center gap-3 mb-16">
          <span class="pill">Fácil de decir</span>
          <span class="pill">Memorable</span>
          <span class="pill">Familiar</span>
          <span class="pill pill-accent">100% español</span>
        </div>

        <p class="reveal text-xl md:text-2xl text-foreground-muted max-w-2xl mx-auto">
          En un mar de <span class="line-through text-foreground-muted/70">FarmTech</span> y <span class="line-through text-foreground-muted/70">AgriCloud</span>,
          nosotros hablamos tu idioma.
        </p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="cta-section min-h-screen flex items-center justify-center relative overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-6 text-center">
        <div class="reveal mb-8">
          <svg
            class="w-20 h-20 mx-auto text-primary-400"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M11.264 2.205A4 4 0 0 0 6.42 4.211l-4 8a4 4 0 0 0 1.359 5.117l6 4a4 4 0 0 0 4.438 0l6-4a4 4 0 0 0 1.576-4.592l-2-6a4 4 0 0 0-2.53-2.53z"/>
            <path d="M11.99 22 14 12l7.822 3.184"/>
            <path d="M14 12 8.47 2.302"/>
          </svg>
        </div>

        <h2 class="reveal font-logo text-5xl md:text-7xl text-dark-foreground mb-6">
          crisopa
        </h2>

        <p class="reveal text-xl md:text-2xl text-dark-foreground-muted mb-12">
          Software de gestión agrícola<br>
          <span class="text-dark-foreground font-medium">hecho para el campo español.</span>
        </p>

        <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" data-press class="btn-secondary-dark">
            Volver al inicio
          </a>
          <a href="https://app.cuaderno.es/register" data-press class="btn-primary-dark">
            Prueba gratis
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Logo: el trazo se dibuja una vez al cargar */
  .logo-icon {
    animation: enter-logo 450ms var(--ease-brand) both;
  }

  .logo-text {
    animation: enter-logo 450ms var(--ease-brand) 150ms both;
  }

  .path-main {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: drawPath 1.2s var(--ease-brand) 0.2s forwards;
  }

  .path-detail {
    stroke-dasharray: 50;
    stroke-dashoffset: 50;
    animation: drawPath 0.6s var(--ease-brand) 0.9s forwards;
  }

  @keyframes enter-logo {
    from { opacity: 0; filter: blur(6px); transform: translateY(8px); }
    to { opacity: 1; filter: blur(0); transform: translateY(0); }
  }

  @keyframes drawPath {
    to { stroke-dashoffset: 0; }
  }

  /* Scroll cue: quieto (nada rebota por decorar) */
  .scroll-cue {
    cursor: pointer;
  }

  .mouse {
    width: 26px;
    height: 42px;
    border: 2px solid var(--line-strong);
    border-radius: 13px;
    position: relative;
  }

  .mouse::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--foreground-muted);
    border-radius: 2px;
  }

  /* Tarjetas: superficie + borde 1px + sombra de nivel 1 */
  .story-card {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-1);
  }

  .logo-showcase-card {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-2);
  }

  .symbol-card-mini {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-1);
  }

  .symbol-icon-mini {
    font-size: 2rem;
  }

  /* Pastillas */
  .pill {
    display: inline-flex;
    padding: 0.75rem 1.5rem;
    background: var(--surface);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border: 1px solid var(--line-strong);
  }

  .pill-accent {
    background: var(--green-600);
    color: white;
    border-color: var(--green-600);
  }

  /* Cierre: sección oscura */
  .cta-section {
    background: var(--dark-background);
  }

  /* Botones sobre oscuro: la acción pasa a green-400 */
  .btn-secondary-dark,
  .btn-primary-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .btn-secondary-dark {
    background: var(--dark-surface);
    border: 1px solid var(--dark-line);
    color: var(--dark-foreground);
  }

  .btn-secondary-dark:hover {
    background: var(--dark-line);
  }

  .btn-primary-dark {
    background: var(--green-400);
    color: var(--dark-background);
  }

  .btn-primary-dark:hover {
    background: var(--green-500);
  }

  /* Entrada al hacer scroll: opacidad + desenfoque + 8px, una vez */
  .reveal {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(8px);
    transition: opacity 450ms var(--ease-brand),
                filter 450ms var(--ease-brand),
                transform 450ms var(--ease-brand);
  }

  .reveal.visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  .reveal:nth-child(2) { transition-delay: 60ms; }
  .reveal:nth-child(3) { transition-delay: 120ms; }
  .reveal:nth-child(4) { transition-delay: 180ms; }
  .reveal:nth-child(5) { transition-delay: 240ms; }

  /* Letras interactivas (easter egg): solo cambia el color */
  .letter-interactive {
    cursor: pointer;
    display: inline-block;
    position: relative;
    transition: color 150ms ease-out;
  }

  .letter-interactive:hover,
  .letter-interactive.active {
    color: var(--green-700);
  }

  /* Mensaje de los socios */
  .founders-message {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 450ms var(--ease-brand), max-height 450ms var(--ease-brand);
  }

  .founders-message.visible {
    opacity: 1;
    max-height: 200px;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-icon,
    .logo-text {
      animation: none;
    }

    .path-main,
    .path-detail {
      animation: none;
      stroke-dashoffset: 0;
    }

    .reveal {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>

<script>
  // Entrada de bloques al hacer scroll (una sola vez)
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible')
          observer.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  )

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))

  // Clic en el indicador de scroll
  document.querySelector('.scroll-cue')?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    document.querySelector('.story-section')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' })
  })

  // Easter egg: letras interactivas i y p
  const interactiveLetters = document.querySelectorAll('.letter-interactive')
  const foundersReveal = document.getElementById('founders-reveal')
  const activatedLetters = new Set<string>()

  interactiveLetters.forEach((letter) => {
    letter.addEventListener('click', () => {
      const letterValue = letter.getAttribute('data-letter')
      if (letterValue && !activatedLetters.has(letterValue)) {
        activatedLetters.add(letterValue)
        letter.classList.add('active')

        // Con las dos letras activadas aparece el mensaje
        if (activatedLetters.has('i') && activatedLetters.has('p')) {
          foundersReveal?.classList.add('visible')
        }
      }
    })
  })
</script>
