---
import Layout from '../layouts/Layout.astro'
import HeroMockup from '../components/HeroMockup.astro'
import Eyebrow from '../components/Eyebrow.astro'
import ListaComparada from '../components/ListaComparada.astro'

const calendlyUrl = 'https://calendly.com/demo-crisopa/30min'

const without = [
  'Tardes de oficina cuadrando el papeleo de cada cliente',
  'Registrar tratamientos uno a uno, finca por finca',
  'Revisar a mano dosis, productos y plazos en el registro del MAPA',
  'Software de hace 20 años que no entiende tu flujo',
  'Cada cliente nuevo multiplica las horas de despacho',
]

const withCrisopa = [
  'Se lo dices a ChatGPT o Claude y queda registrado',
  'Planificas la campaña de un cliente en minutos, no en días',
  'El copiloto verifica cada tratamiento contra la ficha del MAPA',
  'Memoria agronómica de cada finca, consultable al instante',
  'De 10 a 100 fincas sin que se disparen tus horas de oficina',
]

const garantias = ['Funciona con ChatGPT y Claude', 'Verificado contra el MAPA', 'Listo para inspecciones']

const features = [
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
    title: 'Copiloto IA (MCP)',
    description: 'Controlas Crisopa desde ChatGPT o Claude que ya usas. Le hablas —incluso por nota de voz al salir de la finca— y registra, planifica y te prepara la recomendación. Tú decides. Cero curva de aprendizaje.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
    title: 'Diario de campo',
    description: 'Visitas estilo Notion y tareas por parcela y campaña. La memoria agronómica de cada cliente, capturada sin fricción y consultable en lenguaje natural.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />',
    title: 'Verificado contra el MAPA',
    description: 'Las recomendaciones cruzan el registro del MAPA y usan la ficha oficial como fuente de verdad. Sin errores de dosis ni de autorización, y con el cuaderno listo para inspección.',
  },
]
---

<Layout
  title="Demo para asesores agronómicos | Crisopa"
  description="Reserva una demo de 30 min y descubre el copiloto agronómico que lleva el papeleo de todas tus fincas. Hablas con ChatGPT o Claude y recuperas tus horas de oficina."
>
  <!-- Landing de campaña: fuera del índice para que no compita con la home, que
       cubre el mismo terreno. Quítalo si algún día debe posicionar por sí sola. -->
  <meta name="robots" content="noindex, follow" slot="head" />

  <main>
    <!-- ==================== HERO ==================== -->
    <section class="sec relative overflow-hidden pt-8 pb-16 sm:pt-12 sm:pb-24 lg:pb-32 lg:min-h-screen flex items-center">

      <div class="w-full">
        <!-- Logo -->
        <div class="mb-10 sm:mb-14">
          <svg class="h-7" viewBox="0 0 510.42032 99.311523" xmlns="http://www.w3.org/2000/svg">
            <g transform="translate(-385.81631,-550.18079)">
              <g class="text-foreground" fill="currentColor">
                <path d="m 869.51978,630.4783 q -6.03135,0 -10.63149,-2.14674 -4.49796,-2.14675 -7.05361,-6.13356 -2.45343,-3.98683 -2.45343,-9.60925 0,-6.13356 2.96458,-10.01815 3.06676,-3.8846 8.48474,-5.82689 5.52023,-1.94229 12.88046,-1.94229 h 12.88053 v 8.48476 h -13.08497 q -4.90685,0 -7.56473,2.45342 -2.55565,2.3512 -2.55565,6.13356 0,3.78237 2.55565,6.13356 2.65788,2.3512 7.56473,2.3512 2.96458,0 5.41801,-1.02225 2.55565,-1.1245 4.19126,-3.68014 1.73783,-2.65787 1.94226,-7.15582 l 3.4757,3.98681 q -0.51111,5.82688 -2.86231,9.81369 -2.24898,3.98683 -6.33801,6.13357 -3.98681,2.04452 -9.81372,2.04452 z"/>
                <path d="m 884.99176,629.04713 v -16.45838 h -2.35121 V 594.2903 q 0,-4.80463 -2.3512,-7.15583 -2.35116,-2.3512 -7.25802,-2.3512 -2.55564,0 -6.13357,0.10227 -3.57792,0.10228 -7.25806,0.30668 -3.57792,0.10227 -6.44023,0.30668 v -12.06268 q 2.3512,-0.20444 5.31574,-0.40889 2.96459,-0.20446 6.03135,-0.20446 3.16903,-0.10228 5.92913,-0.10228 8.58699,0 14.20941,2.24897 5.72462,2.24897 8.58699,7.0536 2.96455,4.80461 2.96455,12.57379 v 34.45017 z"/>
                <path d="m 782.32105,649.49234 v -75.95393 h 11.24487 v 23.92089 l -1.73783,-0.10227 q 0.40888,-8.48476 3.47566,-14.20942 3.16902,-5.72465 8.38254,-8.48476 5.21353,-2.86232 11.65377,-2.86232 5.92911,0 10.63148,2.14675 4.80463,2.14674 8.17811,6.03133 3.4757,3.88458 5.31575,9.09812 1.84004,5.11129 1.84004,11.04041 v 2.14673 q 0,6.03135 -1.84004,11.24488 -1.73783,5.11129 -5.21353,9.0981 -3.37347,3.88459 -8.17805,6.13356 -4.80465,2.14675 -10.73376,2.14675 -6.2358,0 -11.44932,-2.55564 -5.11131,-2.65788 -8.28029,-8.07587 -3.16903,-5.5202 -3.57793,-14.20941 l 4.49793,6.84915 v 36.59691 z m 29.44108,-30.56558 q 4.60019,0 7.97366,-2.24897 3.47566,-2.24897 5.41797,-6.23579 1.94228,-4.08904 1.94228,-9.20034 0,-5.31575 -1.94228,-9.20035 -1.94231,-3.88458 -5.41797,-6.03133 -3.37347,-2.24897 -7.97366,-2.24897 -4.19125,0 -7.76917,1.84008 -3.47566,1.84006 -5.72464,5.41797 -2.14675,3.5779 -2.14675,8.58699 v 4.08903 q 0,4.80463 2.24898,8.17808 2.24898,3.37347 5.82685,5.21354 3.57792,1.84006 7.56473,1.84006 z"/>
                <path d="m 740.44543,630.98944 q -7.36027,0 -12.98274,-2.3512 -5.6224,-2.3512 -9.507,-6.33803 -3.88458,-4.08904 -5.92913,-9.20033 -1.94226,-5.1113 -1.94226,-10.6315 v -2.14675 q 0,-5.72467 2.04449,-10.83596 2.14676,-5.21353 6.03135,-9.20034 3.98681,-4.08904 9.60926,-6.33801 5.62242,-2.3512 12.67603,-2.3512 7.05357,0 12.67599,2.3512 5.62245,2.24897 9.50705,6.33801 3.98681,3.98681 6.03134,9.20034 2.04449,5.11129 2.04449,10.83596 v 2.14675 q 0,5.5202 -2.04449,10.6315 -1.94232,5.11129 -5.82689,9.20033 -3.8846,3.98683 -9.50701,6.33803 -5.62246,2.3512 -12.88048,2.3512 z m 0,-12.16491 q 5.21353,0 8.7914,-2.24897 3.57793,-2.3512 5.41802,-6.23578 1.84004,-3.98682 1.84004,-8.9959 0,-5.11129 -1.94227,-8.99589 -1.84009,-3.98681 -5.52024,-6.23578 -3.57791,-2.3512 -8.58695,-2.3512 -5.00907,0 -8.68922,2.3512 -3.57791,2.24897 -5.52023,6.23578 -1.94228,3.8846 -1.94228,8.99589 0,5.00908 1.84006,8.9959 1.94232,3.88458 5.52023,6.23578 3.57788,2.24897 8.79144,2.24897 z"/>
                <path d="m 676.92617,630.78498 q -11.44932,0 -17.99178,-4.80462 -6.44024,-4.90685 -6.7469,-13.49384 h 12.77825 q 0.30666,2.86233 3.16899,5.21353 2.86231,2.3512 8.99588,2.3512 5.1113,0 8.07588,-1.84008 3.06676,-1.84006 3.06676,-5.00906 0,-2.76011 -2.35119,-4.39572 -2.24899,-1.63563 -7.76918,-2.14675 l -4.90686,-0.51113 q -9.30255,-1.02227 -14.31163,-5.31576 -5.00908,-4.29348 -5.00908,-11.4493 0,-5.72467 2.86232,-9.60926 2.86232,-3.88458 7.8714,-5.82687 5.11129,-2.04452 11.65379,-2.04452 10.22261,0 16.56063,4.49794 6.33797,4.49795 6.64468,13.18716 h -12.77826 q -0.20444,-2.86233 -2.86235,-4.90685 -2.65788,-2.04452 -7.66696,-2.04452 -4.49792,0 -6.95135,1.73784 -2.45343,1.73784 -2.45343,4.49794 0,2.65788 1.94232,4.08904 2.04449,1.43116 6.54246,1.9423 l 4.90686,0.51113 q 9.81366,1.02225 15.33389,5.41797 5.62243,4.39572 5.62243,11.85822 0,5.5202 -3.06676,9.60924 -2.96459,3.98683 -8.38256,6.2358 -5.41798,2.24897 -12.77825,2.24897 z"/>
                <path d="m 631.4357,566.89372 q -4.19126,0 -6.23578,-2.14675 -1.94229,-2.24897 -1.94229,-5.5202 0,-3.47569 1.94229,-5.62244 2.04452,-2.14674 6.23578,-2.14674 4.19127,0 6.13356,2.14674 1.94231,2.14675 1.94231,5.62244 0,3.27123 -1.94231,5.5202 -1.94229,2.14675 -6.13356,2.14675 z"/>
                <path d="m 618.453,584.16991 v -10.6315 h 21.9786 v 10.6315 z"/>
                <path d="m 626.22219,629.04713 v -55.50872 h 14.20941 v 55.50872 z"/>
                <path d="m 578.01783,629.04713 v -55.50872 h 11.24485 v 23.51198 H 588.956 q 0,-11.96044 5.11131,-18.09401 5.1113,-6.13356 15.02722,-6.13356 h 2.04452 v 12.36936 h -3.88459 q -7.15582,0 -11.14263,3.88459 -3.88459,3.78236 -3.88459,11.04041 v 28.92995 z"/>
                <path d="m 540.79725,630.98944 q -7.25805,0 -12.57381,-2.45343 -5.21352,-2.45343 -8.79144,-6.54246 -3.47568,-4.08904 -5.21352,-9.20035 -1.73784,-5.1113 -1.73784,-10.42705 v -1.94229 q 0,-5.62244 1.73784,-10.73375 1.84007,-5.21352 5.41799,-9.20033 3.5779,-4.08904 8.79144,-6.44024 5.31574,-2.45342 12.26711,-2.45342 7.25804,0 12.98271,2.86233 5.72465,2.76009 9.09812,7.76917 3.47568,5.00908 3.88458,11.65377 h -13.80051 q -0.51114,-4.29349 -3.68014,-7.15582 -3.06678,-2.86234 -8.48476,-2.86234 -4.7024,0 -7.87141,2.24898 -3.06677,2.24897 -4.60017,6.23578 -1.53339,3.8846 -1.53339,8.99589 0,4.90686 1.43116,8.89367 1.5334,3.98681 4.60019,6.2358 3.169,2.24896 8.07585,2.24896 3.68013,0 6.33801,-1.32894 2.65787,-1.32893 4.19127,-3.68013 1.63561,-2.3512 2.04452,-5.31576 h 13.8005 q -0.40889,6.74692 -3.98681,11.85821 -3.47568,5.00908 -9.30256,7.87141 -5.72466,2.86234 -13.08493,2.86234 z"/>
              </g>
              <g class="text-primary-600" fill="currentColor">
                <g transform="matrix(10.535868,0,0,10.535868,377.23299,402.99239)">
                  <path d="m 4.5614529,13.972116 c -0.7680582,0.03238 -1.4896607,0.473821 -1.8497924,1.194336 l -1.6696231,3.339245 c -0.48648218,0.973025 -0.16981182,2.165967 0.7353515,2.769389 l 2.5044348,1.669624 c 0.7260457,0.484093 1.675668,0.484093 2.4017136,0 L 9.1879721,21.275086 C 9.9980394,20.734954 10.348377,19.713959 10.040719,18.790218 L 9.2059075,16.285784 C 8.9905729,15.639704 8.4831895,15.131506 7.8371101,14.916171 L 5.3326753,14.081359 C 5.0779782,13.996377 4.8174722,13.961326 4.5614529,13.972121 Z m 0.4581682,1.048407 2.5036194,0.835625 a 0.49527016,0.49527016 0 0 0 8.348e-4,0 c 0.3511263,0.117026 0.6256605,0.391564 0.7426889,0.742689 l 0.8348115,2.504436 c 0.168046,0.504557 -0.020591,1.053389 -0.4630594,1.348416 l -2.5044348,1.669622 c -0.3956815,0.263822 -0.9070811,0.263822 -1.3027626,0 L 2.3268842,20.451689 C 1.8308028,20.120991 1.6607846,19.482442 1.9273942,18.949191 l 1.6696231,-3.339247 c 0.2630345,-0.526252 0.8645231,-0.775633 1.4226038,-0.589421 z"/>
                  <path d="m 6.5058594,18.181641 a 0.49527003,0.49527003 0 0 0 -0.6738282,0.359375 l -0.8378906,4.175781 a 0.49522051,0.49522051 0 0 0 0.3867188,0.582031 0.49522051,0.49522051 0 0 0 0.5839843,-0.388672 l 0.7207032,-3.585937 2.7109375,1.103515 A 0.49522051,0.49522051 0 0 0 10.041016,20.154297 0.49522051,0.49522051 0 0 0 9.7695313,19.509766 Z"/>
                  <path d="m 3.765625,14.162109 a 0.49522051,0.49522051 0 0 0 -0.1855469,0.673829 l 2.3085938,4.048828 a 0.49522051,0.49522051 0 0 0 0.6757812,0.185546 0.49522051,0.49522051 0 0 0 0.1835938,-0.675781 L 4.4394531,14.345703 A 0.49522051,0.49522051 0 0 0 3.765625,14.162109 Z"/>
                </g>
              </g>
            </g>
          </svg>
        </div>

        <!-- Two columns -->
        <div class="lg:grid lg:grid-cols-12 lg:gap-x-12 items-center">
          <!-- Copy -->
          <div class="lg:col-span-6 flex flex-col justify-center">
            <!-- Encima del titular, como mucho, la etiqueta con caret (sin pastilla-anuncio) -->
            <div class="animate-enter" style="animation-delay: 100ms;">
              <Eyebrow>Para asesores agronómicos</Eyebrow>
            </div>

            <h1 id="headline" class="mt-8 text-3xl text-foreground sm:text-4xl lg:text-5xl animate-enter" style="animation-delay: 150ms;">
              El copiloto que lleva el papeleo
              <span id="headline-accent" class="text-foreground-muted">de todas tus fincas</span>
            </h1>

            <p id="subtitle" class="mt-6 text-base leading-relaxed text-foreground-muted sm:text-lg max-w-xl animate-enter" style="animation-delay: 200ms;">
              Habla con ChatGPT o Claude y registra visitas, planifica campañas y crea tratamientos verificados contra el MAPA. Recupera las horas de oficina que hoy pierdes cuadrando el papeleo de cada cliente.
            </p>

            <!-- CTA -->
            <div class="mt-8 animate-enter" style="animation-delay: 250ms;">
              <a
                href={calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                id="cta-demo"
                data-press
                class="group inline-flex items-center justify-center rounded-md bg-primary-600 px-6 py-3.5 sm:px-8 sm:py-4 text-base font-medium text-white hover:bg-primary-700"
              >
                <span class="flex items-center gap-2">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Reservar demo
                  <svg class="h-5 w-5 transition-transform duration-150 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </span>
              </a>
              <p class="mt-3 font-data text-xs text-foreground-muted">Menos de 30 min &middot; Sin compromiso &middot; Online</p>
            </div>

            <!-- Garantías: iconos de trazo, sin baldosas de color -->
            <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-foreground-muted animate-enter" style="animation-delay: 300ms;">
              {garantias.map((g) => (
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                  {g}
                </li>
              ))}
            </ul>
          </div>

          <!-- Mockup -->
          <div class="mt-12 sm:mt-16 lg:mt-0 lg:col-span-6 animate-enter" style="animation-delay: 250ms;">
            <!-- La ventana de producto sola sobre el fondo: sin insignias flotantes alrededor -->
            <div class="relative">
              <HeroMockup />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== COMPARATIVA ==================== -->
    <section class="sec relative overflow-hidden">
      <div class="sec-head mb-12 sm:mb-16" data-animate>
        <h2 class="text-foreground">
          El software que <span class="text-foreground-muted">escala contigo</span>
        </h2>
        <p class="lead">
          Cuantas más fincas llevas, más tiempo pierdes con herramientas que no están pensadas para ti.
        </p>
      </div>

      <ListaComparada
        etiquetaSin="Ahora mismo"
        etiquetaCon="Con Crisopa"
        sin={without}
        con={withCrisopa}
      />
    </section>

    <!-- ==================== FEATURES ==================== -->
    <section class="sec relative overflow-hidden">
      <div class="mb-12 sm:mb-16" data-animate>
        <h2 class="max-w-[20ch] text-foreground">
          Pensado para quien lleva <span class="text-foreground-muted">decenas de fincas</span>
        </h2>
      </div>

      <div class="cells sm:grid-cols-3" data-animate>
        {features.map((feature) => (
          <div class="p-6 sm:p-8">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <Fragment set:html={feature.icon} />
            </svg>
            <h3 class="mt-8 text-lg text-foreground">{feature.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-foreground-muted">{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ==================== CTA FINAL ==================== -->
    <section class="sec sec-dark relative overflow-hidden">
      <div class="relative mx-auto max-w-3xl text-center" data-animate>
        <h2 class="text-dark-foreground">
          30 minutos que te pueden ahorrar horas cada semana
        </h2>

        <p class="mt-6 text-lg text-dark-foreground-muted">
          Te enseñamos cómo funciona Crisopa con tus fincas reales. Sin compromiso, sin presión.
        </p>

        <div class="mt-10">
          <a
            href={calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-press
            class="cta-demo-bottom group inline-flex items-center justify-center rounded-md bg-primary-400 px-8 py-4 text-base font-medium text-dark-background hover:bg-primary-300"
          >
            <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Reservar demo
            <svg class="ml-2 h-5 w-5 transition-transform duration-150 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 font-data text-xs text-dark-foreground-muted">
          {['Menos de 30 min', 'Sin compromiso', 'Online'].map((g) => (
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {g}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Footer mínimo -->
    <footer class="gutter py-6 text-center">
      <div class="flex items-center justify-center gap-4 text-sm text-foreground-muted">
        <a href="/privacidad" class="hover:text-foreground transition-colors duration-150 ease-out">Privacidad</a>
        <span>&middot;</span>
        <a href="/terminos" class="hover:text-foreground transition-colors duration-150 ease-out">Términos</a>
        <span>&middot;</span>
        <a href="/cookies" class="hover:text-foreground transition-colors duration-150 ease-out">Cookies</a>
      </div>
    </footer>
  </main>

  <!-- A/B testing + tracking -->
  <script>
    const variants: Record<string, { headline: string; accent: string; subtitle: string }> = {
      a: {
        headline: 'El copiloto que lleva el papeleo',
        accent: 'de todas tus fincas',
        subtitle: 'Habla con ChatGPT o Claude y registra visitas, planifica campañas y crea tratamientos verificados contra el MAPA. Recupera las horas de oficina que hoy pierdes cuadrando el papeleo de cada cliente.',
      },
      b: {
        headline: 'Deja de perder tardes',
        accent: 'cuadrando el cuaderno',
        subtitle: 'Habla con ChatGPT o Claude y registra lo que haces en campo al instante, incluso por nota de voz. El copiloto agronómico para asesores que llevan decenas de fincas.',
      },
      c: {
        headline: 'Planifica una campaña entera',
        accent: 'en menos de 5 minutos',
        subtitle: 'Le das contexto a tu IA y genera tratamientos, riegos y abonado en sus fechas. El copiloto que recupera tus horas de oficina, de 10 a 100 fincas.',
      },
    }

    document.addEventListener('astro:page-load', () => {
      const v = new URLSearchParams(window.location.search).get('v')
      const copy = v && variants[v] ? variants[v] : null

      if (copy) {
        const h1 = document.getElementById('headline')
        const accent = document.getElementById('headline-accent')
        const subtitle = document.getElementById('subtitle')

        if (h1 && accent) {
          h1.childNodes.forEach(n => { if (n.nodeType === Node.TEXT_NODE) n.textContent = '' })
          // El acento va en línea (titular en dos tonos): hace falta el espacio
          h1.insertBefore(document.createTextNode(copy.headline + ' '), accent)
          accent.textContent = copy.accent
        }
        if (subtitle) subtitle.textContent = copy.subtitle
      }

      // Tracking
      document.querySelectorAll('#cta-demo, .cta-demo-bottom').forEach(cta => {
        cta.addEventListener('click', () => {
          if ((window as any).va) {
            ;(window as any).va('event', {
              name: 'cta_demo_hola',
              data: { variant: v || 'a' },
            })
          }
          // Google Ads conversion — clic en "Reservar demo"
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'conversion', {
              send_to: 'AW-18086869043/Viu9CMvzgpwcELPwvrBD',
              value: 1.0,
              currency: 'EUR',
            })
          }
        })
      })
    })
  </script>
