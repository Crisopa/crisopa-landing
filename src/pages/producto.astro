---
/**
 * Página de producto: qué es Crisopa, para quien ya lo está evaluando. No es
 * la home: aquí no se convence, se explica. Cada idea va con su escena de
 * interfaz animada (`components/producto/`) y una o dos frases, no más.
 *
 * Orden: lo que no es → puesta en marcha con la PAC → funcionalidades → web
 * y móvil → ChatGPT y Claude frente al formulario (la única sección oscura) →
 * cierre claro con la demo y los precios.
 *
 * Secciones sin numerar: no es una secuencia como la home.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Footer from '../components/Footer.astro'
import NoEs from '../components/producto/NoEs.astro'
import PuestaEnMarcha from '../components/producto/PuestaEnMarcha.astro'
import FnOrdenes from '../components/producto/FnOrdenes.astro'
import FnAvisos from '../components/producto/FnAvisos.astro'
import FnAlbaranes from '../components/producto/FnAlbaranes.astro'
import FnAbonado from '../components/producto/FnAbonado.astro'
import FnDiario from '../components/producto/FnDiario.astro'
import FnPartes from '../components/producto/FnPartes.astro'
import MovilWeb from '../components/producto/MovilWeb.astro'
import ChatVsMano from '../components/producto/ChatVsMano.astro'

const calendlyUrl = 'https://calendly.com/demo-crisopa/30min'

const funciones = [
  {
    titulo: 'Órdenes de tratamiento que pasan al cuaderno',
    texto: 'Preparas la orden, se ejecuta y ajustas lo que se gastó de verdad. El cuaderno se rellena con esa cantidad.',
    escena: FnOrdenes,
  },
  {
    titulo: 'Avisos antes del error',
    texto: 'Dosis, número de aplicaciones, intervalos, productos no autorizados, carnés y equipos que caducan. Te avisa antes de que llegue la sanción.',
    escena: FnAvisos,
  },
  {
    titulo: 'Albaranes y facturas leídos con IA',
    texto: 'Escaneas el albarán, el producto entra en el almacén y se reparte entre las parcelas hasta que cuadra.',
    escena: FnAlbaranes,
  },
  {
    titulo: 'Planes de abonado y balance de NPK',
    texto: 'Cada aporte suma sus unidades fertilizantes y ves en todo momento cuánto falta para cumplir el plan.',
    escena: FnAbonado,
  },
]

const menores = [
  {
    titulo: 'Diario de visitas y gestión de tareas inteligente',
    texto: 'Anotas la visita y aparecen las tareas que salen de ella.',
    escena: FnDiario,
  },
  {
    titulo: 'Partes de trabajo',
    texto: 'Horas de personal y maquinaria, por labor y por parcela.',
    escena: FnPartes,
  },
]

const ademas = [
  'Riego',
  'Eco-regímenes',
  'Cosecha comercializada',
  'Semilla tratada',
  'Post-cosecha y transporte',
  'Documentación interna',
  'Carnés ROPO e inspecciones',
  'Cuaderno en PDF',
  'Exportación RETO',
  'API',
]
---

<Layout
  title="Producto: qué es Crisopa y qué hace | Crisopa"
  description="Qué es Crisopa y qué no: puesta en marcha desde la PAC con SIGPAC, ROPO y ROMA, órdenes de tratamiento, avisos, albaranes leídos con IA, abonado NPK, diario, tareas y partes. En web, en el móvil y desde ChatGPT y Claude."
>
  <Header />
  <main>
    <!-- Lo que no es, y lo que es. El padding superior deja sitio al header fijo. -->
    <section class="sec pt-28 sm:pt-36">
      <div data-animate>
        <Eyebrow>Producto</Eyebrow>
        <h1 class="mt-5 text-[2.5rem] text-foreground sm:text-5xl lg:text-6xl">Crisopa no es…</h1>
      </div>

      <div class="mt-10 sm:mt-14">
        <NoEs />
      </div>

      <p class="es mt-14 max-w-[34ch] sm:mt-20" data-animate>
        Es una herramienta que simplifica el cuaderno de campo
        <span class="text-foreground-muted">y el control de todas las explotaciones que llevas.</span>
      </p>
    </section>

    <!-- Puesta en marcha -->
    <section id="puesta-en-marcha" class="sec">
      <div class="sec-head" data-animate>
        <div>
          <Eyebrow>Puesta en marcha</Eyebrow>
          <h2 class="mt-5 text-foreground">Operativo en 5 minutos</h2>
        </div>
        <p class="lead">
          Subes la declaración de la PAC en PDF o en Excel. Crisopa lee los recintos y trae de SIGPAC,
          ROPO y ROMA las parcelas, los aplicadores y la maquinaria.
        </p>
      </div>
      <div class="mt-12 sm:mt-16" data-animate>
        <PuestaEnMarcha />
      </div>
    </section>

    <!-- Funcionalidades: texto corto y su escena, alternando lados -->
    <section id="funcionalidades" class="sec">
      <div class="sec-head" data-animate>
        <div>
          <Eyebrow>Funcionalidades</Eyebrow>
          <h2 class="mt-5 text-foreground">Qué hace Crisopa</h2>
        </div>
        <p class="lead">
          Lleva en un solo sitio el cuaderno de explotación de todas tus fincas, campaña a campaña:
          parcelas SIGPAC, tratamientos, abonado, riego, almacén, personal y maquinaria. Cada
          operación se cruza con el registro del MAPA, descuenta su producto del almacén y queda
          anotada en el cuaderno, listo para sacar en PDF.
        </p>
      </div>

      <div class="mt-12 grid gap-16 sm:mt-16 lg:gap-24 [&>*]:min-w-0">
        {funciones.map((f, i) => (
          <div class:list={['grid items-center gap-8 lg:gap-14 [&>*]:min-w-0', i % 2 === 1 ? 'lg:grid-cols-[1.4fr_1fr]' : 'lg:grid-cols-[1fr_1.4fr]']} data-animate>
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <h3 class="text-2xl text-foreground sm:text-[1.75rem]">{f.titulo}</h3>
              <p class="mt-3 max-w-[44ch] text-[17px] leading-relaxed text-foreground-muted">{f.texto}</p>
            </div>
            <f.escena />
          </div>
        ))}

        <div class="grid gap-16 lg:grid-cols-2 lg:gap-10 [&>*]:min-w-0">
          {menores.map((f) => (
            <div data-animate>
              <h3 class="text-2xl text-foreground sm:text-[1.75rem]">{f.titulo}</h3>
              <p class="mt-3 max-w-[44ch] text-[17px] leading-relaxed text-foreground-muted">{f.texto}</p>
              <div class="mt-8">
                <f.escena />
              </div>
            </div>
          ))}
        </div>

        <div data-animate>
          <h3 class="text-2xl text-foreground sm:text-[1.75rem]">Y además</h3>
          <ul class="mt-6 flex flex-wrap gap-2.5">
            {ademas.map((a) => (
              <li class="rounded-full border border-line-strong bg-surface px-4 py-2 text-[15px] text-foreground">{a}</li>
            ))}
            <li class="px-2 py-2 text-[15px] text-foreground-muted">y más</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Web y móvil -->
    <section id="web-y-movil" class="sec">
      <div class="sec-head" data-animate>
        <div>
          <Eyebrow>Web y móvil</Eyebrow>
          <h2 class="mt-5 text-foreground">El mismo cuaderno en el móvil y en el ordenador</h2>
        </div>
        <p class="lead">Lo que anotas en la finca aparece en el panel. Lo que preparas en el panel te llega al móvil.</p>
      </div>
      <div class="mt-12 sm:mt-16" data-animate>
        <MovilWeb />
      </div>
    </section>

    <!-- ChatGPT y Claude frente al formulario: la única sección oscura -->
    <section id="chatgpt-y-claude" class="sec sec-dark">
      <div class="sec-head" data-animate>
        <div>
          <Eyebrow dark>ChatGPT y Claude</Eyebrow>
          <h2 class="mt-5 text-dark-foreground">El mismo tratamiento, a mano y con una nota de voz</h2>
        </div>
        <p class="lead text-dark-foreground-muted">
          Crisopa se conecta a ChatGPT y a Claude. Lo que a mano son once campos, hablando es un mensaje.
        </p>
      </div>
      <div class="mt-12 sm:mt-16" data-animate>
        <ChatVsMano />
      </div>
    </section>

    <!-- Cierre claro: la página explica; la acción, a mano -->
    <section class="sec">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between" data-animate>
        <div>
          <h2 class="text-foreground">Míralo en tus explotaciones</h2>
          <p class="lead mt-4">En la demo lo ponemos en marcha con la PAC de una de tus explotaciones.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-press
            class="group inline-flex items-center justify-center gap-2 rounded-md bg-primary-600 px-6 py-3.5 text-base font-medium text-white hover:bg-primary-700"
          >
            Reservar demo
            <svg class="h-5 w-5 transition-transform duration-150 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="/precios"
            data-press
            class="inline-flex items-center justify-center rounded-md border border-line-strong bg-surface px-6 py-3.5 text-base font-medium text-foreground hover:bg-surface-secondary"
          >
            Ver precios
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Lo que sí es: el tamaño de un H2, en frase */
  .es {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--foreground);
    text-wrap: balance;
  }

  @media (width >= 40rem) {
    .es {
      font-size: 2.25rem;
    }
  }

  @media (width >= 64rem) {
    .es {
      font-size: 2.75rem;
    }
  }
</style>
