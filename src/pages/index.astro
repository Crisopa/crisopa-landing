---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Showcase from '../components/Showcase.astro'
import AsistenteIA from '../components/AsistenteIA.astro'
import CasosDeUso from '../components/CasosDeUso.astro'
import Features from '../components/Features.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Comparison from '../components/Comparison.astro'
import Positioning from '../components/Positioning.astro'
import FAQ from '../components/FAQ.astro'
import CTADemo from '../components/CTADemo.astro'
import CTA from '../components/CTA.astro'
import ContactSales from '../components/ContactSales.astro'
import Footer from '../components/Footer.astro'
import { faqs } from '../lib/faqs'
import { softwareApplicationSchema, faqSchema } from '../lib/schema'

// La home no pasa `title` ni `description`: los del Layout ya están escritos
// para ella y son los que se usan por defecto.
//
// Numeración de las etiquetas de sección (01 ·, 02 ·…): la pone la página, en
// el orden real en que se montan las secciones. Si se reordenan o se añade
// una, se renumera aquí. Hero y cierre (CTADemo, CTA) quedan fuera de la
// secuencia; Positioning es el remate de AsistenteIA y no lleva número propio.
---

<Layout schema={[softwareApplicationSchema, faqSchema(faqs)]}>
  <Header />
  <main>
    <Hero />
    <Showcase n="01" />
    <AsistenteIA n="02" />
    <Positioning />
    <Features n="03" />
    <CasosDeUso n="04" />
    <HowItWorks n="05" />
    <Comparison n="06" />
    <FAQ n="07" />
    <CTADemo />
    <CTA />
  </main>
  <ContactSales />
  <Footer />
</Layout>
