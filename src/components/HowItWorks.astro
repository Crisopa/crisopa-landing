---
import Eyebrow from './Eyebrow.astro'

interface Props {
  /** Numeración de la sección en la página («05»). */
  n?: string
}

const { n } = Astro.props

const steps = [
  {
    number: '01',
    title: 'Conecta tu IA',
    description: 'Enlazas Crisopa con ChatGPT o Claude. Se hace una vez, en un par de minutos, y listo.',
    icon: 'link',
  },
  {
    number: '02',
    title: 'Háblale o escríbele',
    description: 'Le dices lo que has hecho o lo que quieres planificar —por texto o nota de voz— y él lo registra en Crisopa.',
    icon: 'mic',
  },
  {
    number: '03',
    title: 'El cuaderno se cuadra solo',
    description: 'La IA lo verifica contra el MAPA en tiempo real. Tú lo revisas en un minuto.',
    icon: 'check-circle',
  },
]

const iconPaths: Record<string, string> = {
  'link': 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  'mic': 'M19 11a7 7 0 01-14 0m7 7v4m-4 0h8M12 1a3 3 0 00-3 3v7a3 3 0 006 0V4a3 3 0 00-3-3z',
  'check-circle': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
}
---

<section id="como-funciona" class="sec relative overflow-hidden">
  <!-- Header -->
  <div class="sec-head" data-animate>
    <div>
      <Eyebrow n={n}>Cómo funciona</Eyebrow>
      <h2 class="mt-5 text-foreground">
        Empieza en minutos
      </h2>
    </div>
    <p class="lead">
      Conéctala una vez y, a partir de ahí, trabajas conversando: por voz o por escrito.
    </p>
  </div>

  <!-- Pasos en celdas (boceto › .cells) -->
  <div class="cells mt-12 sm:mt-16 lg:grid-cols-3" data-animate>
    {steps.map((step) => (
      <div class="p-7 sm:p-8">
        <!-- Icono + índice de paso -->
        <div class="flex items-center justify-between">
          <svg class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[step.icon]} />
          </svg>
          <span class="font-data text-xs text-foreground-muted">
            {step.number}
          </span>
        </div>

        <!-- Text -->
        <h3 class="mt-10 text-xl text-foreground">
          {step.title}
        </h3>
        <p class="mt-3 text-[15px] text-foreground-muted leading-relaxed">
          {step.description}
        </p>
      </div>
    ))}
  </div>

  <!-- Bottom CTA hint -->
  <p class="mt-6 text-sm text-foreground-muted" data-animate>
    Se conecta en menos de lo que tarda un café.
  </p>
</section>
