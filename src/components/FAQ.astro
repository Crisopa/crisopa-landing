---
import { faqs } from '../lib/faqs'
import Eyebrow from './Eyebrow.astro'

interface Props {
  /** Numeración de la sección en la página («07»). */
  n?: string
}

const { n } = Astro.props
---

<section id="faq" class="sec relative">
  <!-- Cabecera a la izquierda (fija al hacer scroll en escritorio), preguntas a la derecha -->
  <div class="grid gap-10 sm:gap-12 lg:grid-cols-[1fr_2fr] lg:gap-14">
    <!-- Header -->
    <div data-animate>
      <div class="lg:sticky lg:top-28">
        <Eyebrow n={n}>Dudas</Eyebrow>
        <h2 class="mt-5 text-foreground">
          Preguntas frecuentes
        </h2>
      </div>
    </div>

    <!-- FAQ Accordion: una sola caja, preguntas separadas por líneas de 1px -->
    <div class="rounded-lg border border-line bg-surface divide-y divide-line overflow-hidden">
      {faqs.map((faq, index) => (
        <div
          class="faq-item group"
          data-animate
          style={`transition-delay: ${index * 40}ms;`}
        >
          <div class="relative">
            <button
              type="button"
              class="faq-button flex w-full items-center justify-between px-4 py-4 sm:px-6 sm:py-5 text-left transition-colors duration-150 ease-out hover:bg-surface-secondary"
              aria-expanded="false"
              aria-controls={`faq-content-${index}`}
            >
              <span class="text-base font-medium text-foreground pr-4">
                {faq.question}
              </span>
              <div class="flex-shrink-0 ml-4">
                <div class="faq-icon-wrapper w-8 h-8 rounded-full border border-line bg-surface-secondary flex items-center justify-center transition-colors duration-200 ease-brand">
                  <svg
                    class="faq-icon h-4 w-4 text-foreground-muted transition-[rotate,color] duration-200 ease-brand"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </button>
            <div
              id={`faq-content-${index}`}
              class="faq-content overflow-hidden transition-[max-height,opacity] duration-250 ease-brand"
              style="max-height: 0; opacity: 0;"
            >
              <div class="px-4 pb-4 pt-0 sm:px-6 sm:pb-5">
                <div class="h-px bg-line mb-4"></div>
                <p class="text-foreground-muted leading-relaxed">{faq.answer}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // FAQ accordion
  const faqItems = document.querySelectorAll('.faq-item')

  // Estado abierto: icono en verde (estado activo). Cerrado: neutro.
  const setOpen = (item: Element, open: boolean) => {
    const button = item.querySelector('.faq-button')
    const content = item.querySelector('.faq-content') as HTMLElement | null
    const icon = item.querySelector('.faq-icon')
    const iconWrapper = item.querySelector('.faq-icon-wrapper')

    button?.setAttribute('aria-expanded', open.toString())
    if (content) {
      content.style.maxHeight = open ? content.scrollHeight + 'px' : '0'
      content.style.opacity = open ? '1' : '0'
    }
    icon?.classList.toggle('rotate-180', open)
    icon?.classList.toggle('text-white', open)
    icon?.classList.toggle('text-foreground-muted', !open)
    iconWrapper?.classList.toggle('bg-primary-600', open)
    iconWrapper?.classList.toggle('border-primary-600', open)
    iconWrapper?.classList.toggle('bg-surface-secondary', !open)
    iconWrapper?.classList.toggle('border-line', !open)
  }

  faqItems.forEach(item => {
    const button = item.querySelector('.faq-button')

    button?.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true'

      // Cerrar los demás
      faqItems.forEach(otherItem => {
        if (otherItem !== item) setOpen(otherItem, false)
      })

      setOpen(item, !isExpanded)
    })
  })
</script>
