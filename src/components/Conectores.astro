---

<div class="cells grid-cols-2 md:grid-cols-4">
  {ia.map((item) => (
    <div class="col-span-2 flex items-center gap-4 p-5 sm:p-6">
      <span class={`flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-md text-white ${item.color}`}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-6 w-6">
          <path d={item.d} />
        </svg>
      </span>
      <span class="grid gap-1">
        <span class="font-display text-[17px] font-semibold leading-tight tracking-[-0.02em] text-foreground">{item.nombre}</span>
        <span class="font-data text-xs text-foreground-muted">Conector MCP</span>
      </span>
    </div>
  ))}
  {conectores.map((item) => (
    <div class="flex items-center gap-3 px-5 py-4 sm:px-6 sm:py-5">
      <span class="flex h-6 min-w-6 flex-shrink-0 items-center justify-center text-foreground-muted">
        {item.d ? (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
            <path d={item.d} />
          </svg>
        ) : (
          <span class="font-data text-[11px] font-medium" aria-hidden="true">{item.texto}</span>
        )}
      </span>
      <span class="text-sm text-foreground">{item.nombre}</span>
    </div>
  ))}
</div>
