---
/**
 * Demo oscura (brand-visual.md › Secciones oscuras · El producto como imagen):
 * el rigor. El hero cuenta el ciclo entero, rápido; esta se para en lo que
 * allí es una línea con un indicador de carga: las comprobaciones contra el
 * registro. Enseña el error más común, repetir un producto que solo admite
 * una aplicación por campaña, y cómo Crisopa lo detiene.
 *
 * - Izquierda, la conversación: el asesor pide Juvinal contra piojo rojo;
 *   Crisopa lee la ficha y el historial de la parcela, se niega y propone
 *   una alternativa; el asesor la acepta y Crisopa pone la dosis y valida.
 * - Derecha: un aviso rojo, pequeño, que tiembla una vez al saltar; luego la
 *   orden correcta entra encima y lo tapa, a la altura de la conversación
 *   que la produjo, y se firma.
 * - Es una de las dos secciones oscuras de la home (la otra, el CTA final).
 * - El HTML trae el estado final completo (orden firmada, sin aviso): sin JS
 *   o con `prefers-reduced-motion`, la demo se ve entera y quieta.
 * - Con movimiento: cada paso entra en su momento (`data-at`, en ms, desde
 *   `T`), al ritmo de lectura, con el gesto de entrada de marca. El temblor,
 *   el tapado y la firma cambian por clase en la raíz (`caught`, `resolved`,
 *   `signed`). Una sola vez; el botón de la esquina la relanza.
 * - Datos comprobados contra las fichas del MAPA; no se cambian sin volver a
 *   comprobarlos:
 *   · Juvinal 10 EC (nº 19675, piriproxifen 10 %): cítricos, piojo rojo de
 *     California, 0,05–0,075 %, 1 aplicación por campaña sin superar 2 l/ha;
 *     Spa 1: tampoco con otro producto con piriproxifen. P.S. 30 días.
 *   · Ovispray (nº ES-00090, aceite de parafina 80 %): cítricos, piojo rojo,
 *     en verano (BBCH 69–85) hasta 40 l/ha con 1.000–2.000 l/ha de caldo,
 *     2 aplicaciones cada 60 días. P.S. no procede.
 */
import Eyebrow from './Eyebrow.astro'
import SelloMAPA from './SelloMAPA.astro'
import { REGISTRO_MAPA_SINCRONIZADO, FECHA_ORDEN_DEMO } from '../lib/mapa'

interface Props {
  /** Numeración de la sección en la página («01»). */
  n?: string
}

const { n } = Astro.props

// Guion (ms desde que arranca). Pausas al ritmo de lectura: cada mensaje
// deja tiempo para leerse antes del siguiente paso. `caught`, `resolved` y
// `signed` son cambios de estado en la raíz: el aviso tiembla, la orden lo
// tapa y se firma.
const T = {
  pide: 0,
  ficha: 2400,
  historial: 3400,
  aviso: 4200,
  caught: 4700,
  niega: 5600,
  elige: 9600,
  valida: 10600,
  resolved: 11400,
  campos: 11700,
  campo: 280,
  hecho: 14000,
  verificado: 14800,
  signed: 16600,
}

const orden: { k: string; v: string; mono?: boolean; registro?: string }[] = [
  { k: 'Finca', v: 'La Alquería · parcela 12' },
  { k: 'SIGPAC', v: '46:244:0:0:3:118:1', mono: true },
  { k: 'Cultivo', v: 'Naranjo · Navelina' },
  { k: 'Plaga', v: 'Piojo rojo de California' },
  { k: 'Producto', v: 'Ovispray', registro: 'Nº ES-00090' },
  { k: 'Dosis', v: '30 l/ha · caldo 2.000 l/ha', mono: true },
  // «Para mañana»: el día siguiente a la sincronización del registro (lib/mapa.ts)
  { k: 'Fecha', v: FECHA_ORDEN_DEMO, mono: true },
  { k: 'Plazo seg.', v: 'No procede' },
]
---

<section id="demo" class="sec sec-dark relative overflow-hidden">
  <div class="sec-head" data-animate>
    <div>
      <Eyebrow dark n={n}>Demo</Eyebrow>
      <h2 class="mt-5 text-dark-foreground">
        Del chat a la orden de tratamiento.
        <span class="text-dark-foreground-muted">Tú decides y firmas.</span>
      </h2>
    </div>
    <p class="lead text-dark-foreground-muted">
      Antes era una tarde de oficina, ahora es una conversación.
    </p>
  </div>

  <figure
    class="demo"
    data-demo
    data-caught={T.caught}
    data-resolved={T.resolved}
    data-signed={T.signed}
  >
    <div class="split">
      <div class="d-card">
        <p class="d-label"><span>Conversación</span><time>09:42</time></p>
        <div class="d-chat">
          <p class="u step" data-at={T.pide}>
            Prepárame la orden de Juvinal contra piojo rojo en la parcela 12 de
            La Alquería, para mañana.
          </p>
          <p class="t step" data-at={T.ficha}><span class="ok" aria-hidden="true">✓</span> Crisopa · leer_ficha_registro · 19675</p>
          <p class="t step" data-at={T.historial}><span class="ok" aria-hidden="true">✓</span> Crisopa · listar_registros · parcela 12</p>
          <p class="step" data-at={T.niega}>
            No puedo: Juvinal solo admite una aplicación por campaña y esta
            parcela ya la tiene. Alternativa autorizada: Ovispray, aceite de
            parafina. ¿La preparo?
          </p>
          <p class="u step" data-at={T.elige}>Sí, con Ovispray.</p>
          <p class="t step" data-at={T.valida}><span class="ok" aria-hidden="true">✓</span> Crisopa · validar_tratamiento · parcela 12</p>
          <p class="step" data-at={T.hecho}>
            Hecho: Ovispray a 30 l/ha con 2.000 l/ha de caldo, dentro del
            registro. Lista para tu firma.
          </p>
        </div>
      </div>

      <!-- Aviso y orden comparten celda: la orden entra encima del aviso y lo
           tapa. La celda mide ya lo que la orden, así que nada salta. -->
      <div class="d-col">
        <div class="aviso step" data-at={T.aviso} role="note">
          <p class="aviso-t"><span aria-hidden="true">✕</span> No se puede repetir</p>
          <p>Juvinal 10 EC admite 1 aplicación por campaña en cítricos y la parcela 12 ya la tiene.</p>
          <p class="aviso-src">Ficha MAPA · Nº 19675</p>
        </div>

        <div class="d-card orden step" data-at={T.resolved}>
          <p class="d-label"><span>Orden de tratamiento</span><span>Nº 15</span></p>
          <dl class="order">
            {orden.map((f, i) => (
              <div class="row step" data-at={T.campos + i * T.campo}>
                <dt>{f.k}</dt>
                <dd class:list={[f.mono && 'mono']}>
                  {f.v}
                  {f.registro && <> · <span class="mono">{f.registro}</span></>}
                </dd>
              </div>
            ))}
          </dl>
          <div class="step" data-at={T.verificado}>
            <div class="status">
              <span class="ok">✓ Verificado contra el MAPA</span>
              <span class="sign">
                <span class="sign-pend">Pendiente de firma</span>
                <span class="sign-done">Firmada · J. Martín</span>
              </span>
            </div>
            <SelloMAPA dark fecha={REGISTRO_MAPA_SINCRONIZADO} class="mt-3.5" />
          </div>
        </div>
      </div>
    </div>

    <figcaption class="fig">
      <button type="button" class="replay" data-replay aria-label="Repetir la animación" title="Repetir">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
        </svg>
      </button>
    </figcaption>
  </figure>
</section>

<style>
  .demo {
    margin: 56px 0 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 20px;
    /* Misma altura: conversación y orden se leen como un par */
    align-items: stretch;
  }

  .d-col {
    display: grid;
    min-width: 0;
  }

  .d-col > * {
    grid-area: 1 / 1;
  }

  @media (max-width: 860px) {
    .demo {
      margin-top: 40px;
    }

    .split {
      grid-template-columns: 1fr;
    }
  }

  .d-card {
    min-width: 0;
    padding: 24px;
    background: var(--dark-surface);
    border: 1px solid var(--dark-line);
    border-radius: var(--radius-lg);
    color: var(--dark-foreground);
  }

  @media (max-width: 560px) {
    .d-card {
      padding: 20px 16px;
    }
  }

  .d-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--dark-foreground-muted);
  }

  .d-chat {
    display: grid;
    gap: 14px;
    font-size: 15px;
    line-height: 1.55;
  }

  .d-chat p {
    margin: 0;
  }

  .d-chat .u {
    justify-self: end;
    max-width: 90%;
    padding: 10px 14px;
    /* Zona hundida sobre la tarjeta oscura: el mismo gesto que la burbuja del
       hero (surface-secondary sobre surface), con el neutro oscuro */
    background: var(--dark-background);
    border: 1px solid var(--dark-line);
    border-radius: var(--radius-md);
  }

  .d-chat .t {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
    color: var(--dark-foreground-muted);
    overflow-wrap: anywhere;
  }

  .ok {
    color: var(--green-400);
  }

  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Aviso de error: pequeño, rojo de estado (solo UI de producto), arriba de
     la celda. Tiembla una vez al saltar y la orden lo tapa al llegar. */
  .aviso {
    align-self: start;
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid oklch(from var(--state-error) l c h / 0.45);
    border-radius: var(--radius-md);
    background: oklch(from var(--state-error) l c h / 0.12);
    color: var(--dark-foreground);
    font-size: 14px;
    line-height: 1.45;
  }

  .aviso p {
    margin: 0;
  }

  .aviso-t {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: oklch(from var(--state-error) 0.76 0.15 h);
  }

  .aviso-src {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dark-foreground-muted);
  }

  .caught .aviso {
    animation: aviso-no 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes aviso-no {
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(3px);
    }
  }

  /* Tapado por la orden: se queda quieto mientras ella sube y, ya cubierto,
     se retira detrás */
  .resolved .aviso,
  .demo:not(.playing) .aviso {
    opacity: 0;
    transform: scale(0.97);
  }

  .resolved .aviso {
    transition-delay: 500ms;
  }

  /* La orden sube desde abajo y se monta encima del aviso: más recorrido que
     el gesto de entrada (32px, sin desenfoque), opaca enseguida y con sombra
     para que se lea como una capa encima */
  .orden {
    position: relative;
    box-shadow: 0 -16px 40px -16px oklch(0 0 0 / 0.6);
  }

  .orden.step {
    transition:
      opacity 250ms var(--ease-brand),
      transform 600ms var(--ease-brand);
  }

  .playing .orden.step:not(.in) {
    filter: none;
    transform: translateY(32px);
  }

  /* Lista clave-valor: cada fila es un paso de la animación, con subgrid
     para que las claves compartan columna */
  .order {
    display: grid;
    grid-template-columns: auto 1fr;
    margin: 0;
  }

  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    border-bottom: 1px solid var(--dark-line);
  }

  .row dt,
  .row dd {
    margin: 0;
    padding: 11px 0;
  }

  .row dt {
    padding-right: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dark-foreground-muted);
  }

  .row dd {
    min-width: 0;
    font-size: 15px;
    line-height: 1.4;
  }

  .row dd.mono {
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .row dt {
      padding-right: 16px;
    }
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.3;
  }

  .sign {
    padding: 6px 12px;
    border: 1px solid var(--dark-line);
    border-radius: 9999px;
    color: var(--dark-foreground);
    transition:
      border-color 450ms var(--ease-brand),
      color 450ms var(--ease-brand);
  }

  /* Firmada es el estado final; mientras se reproduce, pendiente hasta la firma */
  .sign-pend,
  .playing:not(.signed) .sign-done {
    display: none;
  }

  .playing:not(.signed) .sign-pend {
    display: inline;
  }

  .demo:not(.playing) .sign,
  .signed .sign {
    border-color: var(--green-400);
    color: var(--green-400);
  }

  /* Pie: repetir en la esquina derecha */
  .fig {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
  }

  .replay {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--dark-line);
    border-radius: var(--radius-sm);
    background: var(--dark-surface);
    color: var(--dark-foreground-muted);
    cursor: pointer;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .replay:hover {
    color: var(--dark-foreground);
    border-color: var(--dark-foreground-muted);
  }

  .replay svg {
    width: 14px;
    height: 14px;
  }

  /* Con ratón, solo aparece al pasar por la demo (o al llegar con teclado).
     En táctil no hay hover: se queda visible. */
  @media (hover: hover) {
    .replay {
      opacity: 0;
      transition:
        opacity 200ms var(--ease-brand),
        color 150ms ease-out,
        border-color 150ms ease-out;
    }

    .demo:hover .replay,
    .replay:focus-visible {
      opacity: 1;
    }
  }

  /* Pasos de la demo: solo se ocultan mientras se reproduce */
  .step {
    transition:
      opacity 450ms var(--ease-brand),
      filter 450ms var(--ease-brand),
      transform 450ms var(--ease-brand);
  }

  .playing .step:not(.in) {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .playing .step:not(.in) {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>

<script>
  type Demo = HTMLElement & { _stop?: () => void }

  function setup(root: Demo) {
    if (root.dataset.ready) return
    root.dataset.ready = '1'

    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-at]'))
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
    if (!steps.length || reduce.matches) return

    // Cambios de estado en la raíz: el aviso tiembla, la orden lo tapa y se
    // firma. Los momentos vienen del guion (T) por el HTML.
    const FLAGS = ['caught', 'resolved', 'signed'] as const
    const flags = FLAGS.map((cls) => ({ cls, at: Number(root.dataset[cls]) }))
    const end = Math.max(...steps.map((s) => Number(s.dataset.at)), ...flags.map((f) => f.at)) + 500
    let timers: number[] = []

    const clear = () => {
      timers.forEach(clearTimeout)
      timers = []
    }

    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms))

    // Estado final completo (el mismo que trae el HTML)
    const finish = () => {
      clear()
      root.classList.remove('playing', ...FLAGS)
    }

    const play = () => {
      clear()
      if (reduce.matches) return finish()
      root.classList.remove(...FLAGS)
      root.classList.add('playing')
      steps.forEach((s) => s.classList.remove('in'))
      steps.forEach((s) => later(Number(s.dataset.at), () => s.classList.add('in')))
      flags.forEach((f) => later(f.at, () => root.classList.add(f.cls)))
      later(end, () => root.classList.remove('playing', ...FLAGS))
    }

    replay?.addEventListener('click', play)

    // Oculta los pasos ya, para que la demo no se vea completa y luego se
    // vacíe al llegar a ella; arranca una sola vez, cuando se ve.
    root.classList.add('playing')
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        io.disconnect()
        later(300, play)
      },
      { threshold: 0.3 },
    )
    io.observe(root)

    root._stop = () => {
      io.disconnect()
      finish()
    }
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<Demo>('[data-demo]').forEach(setup)
  })

  // Al salir de la página (View Transitions), se cortan los temporizadores
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<Demo>('[data-demo]').forEach((el) => el._stop?.())
  })
</script>
