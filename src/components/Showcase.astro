---
import HeroMockup from './HeroMockup.astro'
import Eyebrow from './Eyebrow.astro'

// Sección "Míralo en acción": muestra el producto en un marco de navegador.
//
// CÓMO AÑADIR EL VÍDEO DE SCREEN STUDIO:
//   1. Exporta el vídeo (mp4, ~1280px de ancho, sin audio) a public/demo.mp4
//      y un fotograma de portada a public/demo-poster.jpg.
//   2. Pon hasVideo = true. El <video> sustituye al mockup automáticamente.
const hasVideo = false

interface Props {
  /** Numeración de la sección en la página («01»). */
  n?: string
}

const { n } = Astro.props
---

<section id="demo" class="sec relative overflow-hidden">
  <div>
    <!-- Encabezado -->
    <div class="sec-head" data-animate>
      <div>
        <Eyebrow n={n}>Míralo en acción</Eyebrow>
        <h2 class="mt-5 text-foreground">
          Así de rápido se cuadra el cuaderno
        </h2>
      </div>
      <p class="lead">
        Le hablas a ChatGPT o Claude y queda registrado y cuadrado al momento.
        Sin formularios interminables ni tardes de oficina.
      </p>
    </div>

    <!-- Visual del producto -->
    <div class="relative mt-12 sm:mt-16" data-animate>
      <div class="relative mx-auto max-w-4xl">
        {hasVideo ? (
          <div class="relative rounded-lg bg-surface shadow-2 overflow-hidden border border-line-strong">
            <!-- Barra de navegador -->
            <div class="h-10 bg-surface-secondary border-b border-line flex items-center px-4">
              <div class="flex gap-[6px]">
                <span class="w-[10px] h-[10px] rounded-full bg-line-strong"></span>
                <span class="w-[10px] h-[10px] rounded-full bg-line-strong"></span>
                <span class="w-[10px] h-[10px] rounded-full bg-line-strong"></span>
              </div>
              <div class="flex-1 mx-4">
                <div class="max-w-[200px] mx-auto h-5 bg-surface rounded-sm border border-line flex items-center justify-center">
                  <span class="font-data text-[10px] text-foreground-muted">panel.crisopa.app</span>
                </div>
              </div>
            </div>
            <video
              class="w-full block"
              autoplay
              muted
              loop
              playsinline
              poster="/demo-poster.jpg"
            >
              <source src="/demo.mp4" type="video/mp4" />
            </video>
          </div>
        ) : (
          <HeroMockup />
        )}

        <!-- Sello: verificado -->
        <div class="absolute -bottom-3 -left-3 sm:-bottom-6 sm:-left-6 z-20">
          <div class="w-14 h-14 sm:w-20 sm:h-20 rounded-lg bg-primary-600 shadow-2 flex items-center justify-center">
            <svg class="h-7 w-7 sm:h-10 sm:w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>

        <!-- Sello: normativa -->
        <div class="absolute -top-3 -right-2 sm:-top-5 sm:-right-5 z-20">
          <div class="flex items-center gap-2 rounded-md bg-surface shadow-2 border border-line-strong px-3 py-1.5 sm:px-4 sm:py-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-sm border border-line bg-surface-secondary">
              <svg class="w-4 h-4 text-primary-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <span class="font-data text-xs sm:text-sm font-medium text-foreground">RD 1311/2012</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
