---
/**
 * Ventana de producto del hero (brand-visual.md › El producto como imagen):
 * una conversación que termina en un dato estructurado y verificado.
 *
 * - El HTML trae el estado final completo: sin JS o con
 *   `prefers-reduced-motion`, la ventana se ve entera y quieta.
 * - Con movimiento, al entrar en pantalla (una sola vez) se reinicia: el
 *   mensaje se escribe con caret, entra la llamada a Crisopa y luego la
 *   respuesta (opacidad + desenfoque 6px→0 + 8px, ease-brand). El botón de
 *   la esquina la relanza.
 * - `stacked`: la ventana sube apilada sobre el hero (ver Hero.astro). Si el
 *   apilado está activo, la demo no arranca al verse el 25%, sino cuando la
 *   ventana queda centrada en la pantalla, que es donde termina de subir.
 * - Los productos son filas reales del registro del MAPA (tomate × mosca
 *   blanca). No se cambian sin comprobarlos contra la ficha oficial.
 */
import { REGISTRO_MAPA_SINCRONIZADO, FUENTE_MAPA } from '../lib/mapa'

interface Props {
  stacked?: boolean
}

const { stacked = false } = Astro.props

const pregunta = '¿Qué puedo usar contra mosca blanca en el tomate de la finca Los Llanos?'

const productos = [
  { nombre: 'Abanto', registro: '24643', dosis: '0,75 l/ha', plazo: '1 día', max: '2' },
  { nombre: 'Abanto Max', registro: 'ES-00718', dosis: '0,75 l/ha', plazo: '1 día', max: '2' },
  { nombre: 'Adina', registro: '22166', dosis: '2,6 l/ha', plazo: '3 días', max: '3' },
]
---

<figure class="hero-chat" data-hero-chat data-stacked={stacked ? '' : undefined}>
  <div class="window">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-title">Chat · conectado a Crisopa</span>
      <span class="sync"><span class="live" aria-hidden="true"></span>Registro MAPA · sincronizado <time datetime={REGISTRO_MAPA_SINCRONIZADO}>{REGISTRO_MAPA_SINCRONIZADO}</time></span>
    </div>

    <div class="win-body">
      <p class="msg-user step">
        <span class="sr-only">{pregunta}</span>
        <span class="typed-box" aria-hidden="true">
          <span class="typed-ghost">{pregunta}</span>
          <span data-typed data-text={pregunta}>{pregunta}</span>
        </span>
      </p>

      <p class="tool step">
        <span class="ok" aria-hidden="true">✓</span>
        <span>Crisopa · buscar_productos_autorizados <span class="tool-args">· tomate × mosca blanca</span></span>
      </p>

      <div class="reply step">
        <p>En tomate hay productos vigentes contra mosca blanca. Estos tres encajan para aplicación con tractor o en invernadero:</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Producto</th>
                <th scope="col">Nº registro</th>
                <th scope="col">Dosis</th>
                <th scope="col">Plazo seg.</th>
                <th scope="col">Máx. apl.</th>
              </tr>
            </thead>
            <tbody>
              {productos.map((p) => (
                <tr>
                  <td>{p.nombre}</td>
                  <td class="num">{p.registro}</td>
                  <td class="num">{p.dosis}</td>
                  <td class="num">{p.plazo}</td>
                  <td class="num">{p.max}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="source">
          <span class="check">✓ Verificado contra el MAPA</span>
          <span>{FUENTE_MAPA}</span>
        </div>
      </div>
    </div>

    <button type="button" class="replay" data-replay aria-label="Repetir la animación" title="Repetir">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
        <path d="M3 3v5h5" />
      </svg>
    </button>
  </div>
</figure>

<style>
  .hero-chat {
    margin: 0;
  }

  .window {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .win-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    color: var(--foreground-muted);
    font-variant-numeric: tabular-nums;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--line-strong);
  }

  .sync {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .live {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--green-600);
  }

  /* En móvil estrecho se oculta el título central; la fecha se queda */
  @media (max-width: 560px) {
    .win-bar {
      gap: 8px;
      padding: 10px 12px;
      font-size: 11px;
    }

    .win-title {
      display: none;
    }
  }

  /* Pantallas muy estrechas: sin los puntos, para que la fecha quepa entera */
  @media (max-width: 374px) {
    .dots {
      display: none;
    }
  }

  .win-body {
    display: grid;
    gap: 18px;
    align-content: start;
    /* Abajo deja sitio al botón de repetir */
    padding: 28px 28px 48px;
    min-height: 380px;
  }

  @media (max-width: 560px) {
    .win-body {
      padding: 20px 16px 48px;
      min-height: 0;
    }
  }

  .msg-user {
    justify-self: end;
    max-width: 520px;
    margin: 0;
    padding: 12px 16px;
    background: var(--surface-secondary);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-lg);
    color: var(--foreground);
  }

  /* El texto completo, invisible, fija el tamaño final del bocadillo; el
     que se escribe va encima en la misma celda. Así la ventana no salta al
     pasar la pregunta a dos líneas. */
  .typed-box {
    display: grid;
  }

  .typed-box > * {
    grid-area: 1 / 1;
  }

  .typed-ghost {
    visibility: hidden;
  }

  .tool {
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    max-width: 100%;
    margin: 0;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--foreground-muted);
    overflow-wrap: anywhere;
  }

  .tool .ok {
    color: var(--green-600);
  }

  .reply {
    max-width: 720px;
    min-width: 0;
    color: var(--foreground);
  }

  .reply > p {
    margin: 0 0 14px;
  }

  /* La tabla tiene su propio scroll horizontal en móvil */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    padding: 12px 14px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--foreground-muted);
    background: var(--surface-secondary);
    border-bottom: 1px solid var(--line);
  }

  td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  td.num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--foreground-muted);
  }

  .check {
    color: var(--green-700);
  }

  /* Repetir: control discreto en la esquina inferior de la ventana */
  .replay {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--foreground-muted);
    cursor: pointer;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .replay:hover {
    color: var(--foreground);
    border-color: var(--line-strong);
  }

  .replay svg {
    width: 14px;
    height: 14px;
  }

  /* Con ratón, solo aparece al pasar por la ventana (o al llegar con
     teclado). En táctil no hay hover: se queda visible. */
  @media (hover: hover) {
    .replay {
      opacity: 0;
      transition:
        opacity 200ms var(--ease-brand),
        color 150ms ease-out,
        border-color 150ms ease-out;
    }

    .window:hover .replay,
    .replay:focus-visible {
      opacity: 1;
    }
  }

  /* Pasos de la demo: solo se ocultan mientras se reproduce */
  .step {
    transition:
      opacity 400ms var(--ease-brand),
      filter 400ms var(--ease-brand),
      transform 400ms var(--ease-brand);
  }

  .playing .step:not(.in) {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(8px);
  }

  .typing [data-typed]::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 2px;
    margin-left: 2px;
    background: var(--green-600);
    animation: caret-blink 1.15s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .playing .step:not(.in) {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>

<script>
  type Demo = HTMLElement & { _stop?: () => void }

  // La misma condición que activa el apilado en Hero.astro
  const STACK_QUERY = '(min-width: 861px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)'

  function setup(root: Demo) {
    if (root.dataset.ready) return
    root.dataset.ready = '1'

    const steps = Array.from(root.querySelectorAll<HTMLElement>('.step'))
    const [user, tool, reply] = steps
    const typed = root.querySelector<HTMLElement>('[data-typed]')
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')
    if (!user || !tool || !reply || !typed) return

    const full = typed.dataset.text ?? typed.textContent ?? ''
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
    let timers: number[] = []

    const clear = () => {
      timers.forEach(clearTimeout)
      timers = []
    }

    // Estado final completo (el mismo que trae el HTML)
    const finish = () => {
      clear()
      typed.textContent = full
      user.classList.remove('typing')
      root.classList.remove('playing')
    }

    // Ventana en blanco, lista para escribir
    const reset = () => {
      root.classList.add('playing')
      steps.forEach((s) => s.classList.remove('in'))
      typed.textContent = ''
    }

    const play = () => {
      clear()
      if (reduce.matches) return finish()
      reset()
      user.classList.add('in', 'typing')
      let i = 0
      const type = () => {
        typed.textContent = full.slice(0, ++i)
        if (i < full.length) {
          timers.push(window.setTimeout(type, 22))
          return
        }
        user.classList.remove('typing')
        timers.push(window.setTimeout(() => tool.classList.add('in'), 350))
        timers.push(window.setTimeout(() => reply.classList.add('in'), 1100))
        timers.push(window.setTimeout(() => root.classList.remove('playing'), 1600))
      }
      type()
    }

    replay?.addEventListener('click', play)

    // Arranca una sola vez: cuando se ve el 25% de la ventana o, si sube
    // apilada sobre el hero, cuando su borde superior cruza la mitad de la
    // pantalla (casi asentada: esperar al centro exacto se hace largo).
    const stacked =
      root.dataset.stacked !== undefined &&
      CSS.supports('animation-timeline: view()') &&
      window.matchMedia(STACK_QUERY).matches
    // Apilada, se ve entera mientras sube: sube ya en blanco para no
    // enseñar la respuesta y vaciarla justo al empezar a escribir.
    if (stacked) reset()
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        io.disconnect()
        timers.push(window.setTimeout(play, stacked ? 150 : 400))
      },
      stacked ? { rootMargin: '0px 0px -50% 0px', threshold: 0 } : { threshold: 0.25 },
    )
    io.observe(root)

    root._stop = () => {
      io.disconnect()
      finish()
    }
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<Demo>('[data-hero-chat]').forEach(setup)
  })

  // Al salir de la página (View Transitions), se cortan los temporizadores
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<Demo>('[data-hero-chat]').forEach((el) => el._stop?.())
  })
</script>
