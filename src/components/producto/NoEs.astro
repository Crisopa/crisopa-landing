---
/**
 * «Crisopa no es…»: tres cosas con las que se le confunde, cada una con su
 * miniatura. Entran una a una y se tachan; la miniatura se apaga. Debajo, lo
 * que sí es.
 *
 * Las miniaturas son dibujos de línea con los neutros de la web, no capturas:
 * un ERP (menús y rejilla), un formulario de cuaderno vacío y la Chrysopa.
 */
import Escena from './Escena.astro'

const cosas = [
  {
    titulo: 'Un ERP ni un programa de gestión',
    texto: 'No viene a llevar tu empresa. Lleva el cuaderno y el control de las fincas.',
    ilu: 'erp',
  },
  {
    titulo: 'Un cuaderno de campo de los de siempre',
    texto: 'No tienes que aprender a usarlo ni pasar tardes metiendo datos.',
    ilu: 'form',
  },
  {
    titulo: 'Solo un insecto depredador',
    texto: 'La Chrysopa se come el pulgón. Crisopa, el papeleo.',
    ilu: 'bicho',
  },
]

const campos = ['Fecha', 'Parcela', 'Cultivo', 'Producto', 'Nº registro', 'Dosis', 'Plaga', 'Aplicador']
---

<Escena class="noes" label="Crisopa no es un ERP, ni un cuaderno de campo de los de siempre, ni solo un insecto depredador.">
  <div class="grid">
    {cosas.map((c, i) => (
      <div class="card st" style={`--d: ${i * 250}ms`}>
        <div class="ilu" style={`--d: ${1300 + i * 450}ms`} aria-hidden="true">
          {c.ilu === 'erp' && (
            <div class="erp">
              <div class="erp-bar"><i></i><i></i><i></i></div>
              <div class="erp-tabs">{Array.from({ length: 6 }).map(() => <b></b>)}</div>
              <div class="erp-body">
                <div class="erp-side">{Array.from({ length: 11 }).map((_, j) => <b style={`width:${55 + ((j * 37) % 40)}%`}></b>)}</div>
                <div class="erp-grid">{Array.from({ length: 30 }).map(() => <b></b>)}</div>
              </div>
            </div>
          )}
          {c.ilu === 'form' && (
            <div class="form">
              {campos.map((k) => (
                <div class="f-row">
                  <span>{k}</span>
                  <b></b>
                </div>
              ))}
              <div class="f-foot"><span>Registro 1 de 214</span><b>Guardar</b></div>
            </div>
          )}
          {c.ilu === 'bicho' && (
            <svg class="bicho" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <!-- Alas: dos pares, largas y translúcidas, con venas -->
              <path class="ala" d="M92 58 C 110 20, 160 8, 188 22 C 170 40, 128 54, 92 58 Z" />
              <path class="ala" d="M92 62 C 118 44, 168 46, 190 64 C 164 74, 122 70, 92 62 Z" />
              <path class="ala" d="M88 58 C 70 20, 34 10, 12 24 C 28 42, 60 54, 88 58 Z" />
              <path class="ala" d="M88 62 C 64 46, 26 48, 10 66 C 34 76, 64 70, 88 62 Z" />
              <path class="vena" d="M96 57 C 124 40, 156 26, 184 22 M110 50 l 8 -14 M130 42 l 6 -14 M150 34 l 4 -12 M96 62 C 128 58, 160 60, 186 64 M120 60 l 4 8 M144 60 l 4 8 M166 62 l 3 6" />
              <path class="vena" d="M84 57 C 60 40, 36 28, 16 24 M72 50 l -8 -14 M54 42 l -6 -14 M36 34 l -4 -11 M84 62 C 60 58, 34 60, 14 66 M66 60 l -4 8 M44 61 l -4 7" />
              <!-- Cuerpo, cabeza y antenas -->
              <path class="cuerpo" d="M90 52 C 94 52, 95 60, 94 76 C 93 92, 91 104, 90 108 C 89 104, 87 92, 86 76 C 85 60, 86 52, 90 52 Z" />
              <circle class="cuerpo" cx="90" cy="46" r="5" />
              <circle class="ojo" cx="85.5" cy="44" r="2" />
              <circle class="ojo" cx="94.5" cy="44" r="2" />
              <path d="M88 42 C 80 26, 70 14, 56 6 M92 42 C 100 26, 110 14, 124 6" />
              <path d="M87 60 l -10 8 l -4 10 M93 60 l 10 8 l 4 10 M87 66 l -12 14 M93 66 l 12 14" />
            </svg>
          )}
        </div>
        <p class="tit">
          <span class="tacha" style={`--d: ${1100 + i * 450}ms`}>{c.titulo}</span>
        </p>
        <p class="txt">{c.texto}</p>
      </div>
    ))}
  </div>
</Escena>

<style>
  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-1);
  }

  .ilu {
    display: grid;
    place-items: center;
    height: 168px;
    margin-bottom: 20px;
    padding: 14px;
    background: var(--surface-secondary);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    /* Estado final: apagada */
    opacity: 0.5;
    filter: grayscale(1);
  }

  :global(.espera) .ilu {
    opacity: 1;
    filter: none;
  }

  :global(.run) .ilu {
    animation: apaga 600ms var(--ease-brand) var(--d) both;
  }

  @keyframes apaga {
    from {
      opacity: 1;
      filter: none;
    }
  }

  .tit {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--foreground);
  }

  /* Tachado: una línea que se dibuja de izquierda a derecha sobre el texto */
  .tacha {
    background-image: linear-gradient(var(--foreground), var(--foreground));
    background-repeat: no-repeat;
    background-position: 0 58%;
    background-size: 100% 1.5px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  :global(.espera) .tacha {
    background-size: 0% 1.5px;
  }

  :global(.run) .tacha {
    animation: tacha 500ms var(--ease-brand) var(--d) both;
  }

  @keyframes tacha {
    from {
      background-size: 0% 1.5px;
    }
  }

  .txt {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--foreground-muted);
  }

  /* ---------- ERP: menús, pestañas y rejilla ---------- */
  .erp {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .erp-bar {
    display: flex;
    gap: 4px;
    padding: 5px 7px;
    border-bottom: 1px solid var(--line);
  }

  .erp-bar i {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--line-strong);
  }

  .erp-tabs {
    display: flex;
    gap: 4px;
    padding: 5px 7px;
    border-bottom: 1px solid var(--line);
  }

  .erp-tabs b {
    flex: 1;
    height: 6px;
    border-radius: 2px;
    background: var(--line);
  }

  .erp-body {
    display: grid;
    grid-template-columns: 30% 1fr;
    min-height: 0;
  }

  .erp-side {
    display: grid;
    align-content: start;
    gap: 5px;
    padding: 7px;
    border-right: 1px solid var(--line);
  }

  .erp-side b {
    height: 4px;
    border-radius: 2px;
    background: var(--line-strong);
  }

  .erp-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    align-content: start;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .erp-grid b {
    height: 13px;
    background: var(--surface);
  }

  /* ---------- Formulario de cuaderno vacío ---------- */
  .form {
    width: 100%;
    display: grid;
    gap: 4px;
    padding: 10px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 8.5px;
    color: var(--foreground-muted);
  }

  .f-row {
    display: grid;
    grid-template-columns: 62px 1fr;
    align-items: center;
    gap: 6px;
  }

  .f-row b {
    height: 9px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  .f-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3px;
  }

  .f-foot b {
    padding: 2px 8px;
    border-radius: 3px;
    background: var(--line-strong);
    color: var(--foreground);
    font-weight: 500;
  }

  /* ---------- La Chrysopa ---------- */
  .bicho {
    width: 100%;
    max-width: 230px;
    height: 100%;
    color: var(--green-700);
  }

  .ala {
    fill: oklch(from var(--green-200) l c h / 0.35);
  }

  .vena {
    stroke-width: 0.8;
    opacity: 0.7;
  }

  .cuerpo {
    fill: var(--green-300);
  }

  .ojo {
    fill: var(--green-800);
    stroke: none;
  }
</style>
