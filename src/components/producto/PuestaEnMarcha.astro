---
/**
 * Puesta en marcha: de la declaración de la PAC a la explotación lista.
 *
 * 1. Entra el PDF de la PAC y se leen sus recintos.
 * 2. Se consultan SIGPAC, ROPO y ROMA, uno tras otro.
 * 3. Salen las parcelas sobre el plano, los aplicadores y la maquinaria.
 * 4. El reloj de abajo cuenta hasta los cinco minutos.
 *
 * Datos de ejemplo coherentes con la demo del hero: Los Llanos (Baza,
 * Granada), 6 parcelas de almendro que suman 42,60 ha, Juan Martín y A. Ruiz.
 */
import Escena from './Escena.astro'

const recintos = [
  { nombre: 'Almendros Lauranne', sigpac: '18:23:0:0:12:45:1', ha: '8,40' },
  { nombre: 'Guara', sigpac: '18:23:0:0:12:47:2', ha: '9,15' },
  { nombre: 'Soleta', sigpac: '18:23:0:0:12:51:1', ha: '6,80' },
  { nombre: 'Vairo', sigpac: '18:23:0:0:14:8:3', ha: '7,25' },
  { nombre: 'La Loma', sigpac: '18:23:0:0:14:11:1', ha: '5,60' },
  { nombre: 'El Pozo', sigpac: '18:23:0:0:14:19:2', ha: '5,40' },
]

const fuentes = [
  { nombre: 'SIGPAC', detalle: 'Recintos, usos y superficie', d: 1900 },
  { nombre: 'ROPO', detalle: 'Carnés de los aplicadores', d: 2500 },
  { nombre: 'ROMA', detalle: 'Maquinaria inscrita', d: 3100 },
]

// Plano de las 6 parcelas (viewBox 0 0 240 120), en el mismo orden
const poligonos = [
  'M8 10 L70 6 L74 52 L12 58 Z',
  'M78 6 L150 10 L146 50 L78 52 Z',
  'M156 12 L232 8 L228 46 L152 50 Z',
  'M14 64 L76 58 L80 112 L10 114 Z',
  'M84 58 L150 56 L156 110 L86 112 Z',
  'M160 56 L228 52 L232 108 L162 112 Z',
]

const aplicadores = [
  { nombre: 'Juan Martín', carne: 'ROPO · Cualificado' },
  { nombre: 'A. Ruiz', carne: 'ROPO · Básico' },
]

const maquinas = [
  { nombre: 'Atomizador arrastrado', estado: 'Inspección vigente' },
  { nombre: 'Tractor', estado: 'Inscrito en ROMA' },
]
---

<Escena class="pem" label="Puesta en marcha: se sube la declaración de la PAC de Los Llanos, se consultan SIGPAC, ROPO y ROMA y en cinco minutos la explotación tiene sus 6 parcelas, sus aplicadores y su maquinaria.">
  <div class="win">
    <div class="win-bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url">panel.crisopa.app · Nueva explotación</span>
    </div>

    <div class="body">
      <!-- 1. La PAC -->
      <div class="col">
        <p class="k">Declaración PAC</p>
        <div class="file st">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 13H8" /><path d="M16 17H8" /><path d="M16 13h-2" />
          </svg>
          <span class="file-t">
            <b>PAC 2026 · Los Llanos.pdf</b>
            <span class="mono">Solicitud única · 6 recintos</span>
          </span>
          <span class="barra"><i></i></span>
        </div>
        <ul class="recintos">
          {recintos.map((r, i) => (
            <li class="st" style={`--d: ${900 + i * 140}ms`}>
              <span class="mono">{r.sigpac}</span>
              <span class="mono ha">{r.ha} ha</span>
            </li>
          ))}
        </ul>
      </div>

      <span class="flecha" aria-hidden="true">→</span>

      <!-- 2. Registros oficiales -->
      <div class="col">
        <p class="k">Registros oficiales</p>
        <ul class="fuentes">
          {fuentes.map((f) => (
            <li class="st" style={`--d: ${f.d - 500}ms`}>
              <span>
                <b>{f.nombre}</b>
                <span class="det">{f.detalle}</span>
              </span>
              <span class="estado">
                <span class="st-sale" style={`--d: ${f.d}ms`}><span class="cargando"><i></i><i></i><i></i></span></span>
                <span class="chip chip-ok st" style={`--d: ${f.d}ms`}>✓ Conectado</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <span class="flecha" aria-hidden="true">→</span>

      <!-- 3. La explotación, lista -->
      <div class="col">
        <p class="k">Los Llanos · Baza, Granada</p>
        <div class="bloque">
          <svg class="plano" viewBox="0 0 240 120" aria-hidden="true">
            {poligonos.map((p, i) => <path class="st" style={`--d: ${3500 + i * 120}ms`} d={p} />)}
          </svg>
          <p class="linea st" style="--d: 4300ms"><b>6 parcelas</b><span class="mono">42,60 ha</span></p>
        </div>
        <div class="bloque">
          {aplicadores.map((a, i) => (
            <p class="linea st" style={`--d: ${4500 + i * 150}ms`}><b>{a.nombre}</b><span class="mono">{a.carne}</span></p>
          ))}
        </div>
        <div class="bloque">
          {maquinas.map((m, i) => (
            <p class="linea st" style={`--d: ${4900 + i * 150}ms`}><b>{m.nombre}</b><span class="mono">{m.estado}</span></p>
          ))}
        </div>
      </div>
    </div>

    <div class="pie">
      <span class="listo">
        <span class="st-sale" style="--d: 5400ms">Preparando la explotación…</span>
        <span class="chip chip-ok st" style="--d: 5400ms">✓ Lista para usar</span>
      </span>
      <span class="reloj">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        <span class="mono" data-cuenta="300" data-dur="5200" data-fmt="reloj" style="--d: 200ms">05:00</span>
      </span>
    </div>
  </div>
</Escena>

<style>
  .body {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1.1fr;
    gap: 16px;
    padding: 20px;
  }

  .col {
    display: grid;
    align-content: start;
    gap: 12px;
    min-width: 0;
  }

  .flecha {
    align-self: center;
    font-family: var(--font-mono);
    color: var(--foreground-muted);
  }

  @media (max-width: 960px) {
    .body {
      grid-template-columns: 1fr;
    }

    .flecha {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 560px) {
    .body {
      padding: 16px;
    }
  }

  .file {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-secondary);
    overflow: hidden;
  }

  .file svg {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--state-error);
  }

  .file-t {
    display: grid;
    min-width: 0;
    font-size: 12.5px;
  }

  .file-t b {
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-t .mono {
    font-size: 11px;
    color: var(--foreground-muted);
  }

  /* Barra de lectura del archivo, al pie de la tarjeta */
  .barra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
  }

  .barra i {
    display: block;
    height: 100%;
    background: var(--green-500);
    transform-origin: left;
  }

  :global(.run) .barra i {
    animation: lee 700ms var(--ease-brand) 250ms both;
  }

  @keyframes lee {
    from {
      transform: scaleX(0);
    }
  }

  .recintos,
  .fuentes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .recintos li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
  }

  .recintos .ha {
    color: var(--foreground-muted);
  }

  .fuentes li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .fuentes b {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .det {
    font-size: 12px;
    color: var(--foreground-muted);
  }

  /* Carga y «Conectado» comparten sitio */
  .estado,
  .listo {
    display: grid;
    justify-items: end;
  }

  .listo {
    justify-items: start;
  }

  .estado > *,
  .listo > * {
    grid-area: 1 / 1;
    align-self: center;
  }

  .bloque {
    display: grid;
    gap: 6px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .plano {
    width: 100%;
    height: auto;
    margin-bottom: 2px;
  }

  .plano path {
    fill: var(--green-100);
    stroke: var(--green-600);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .linea {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    font-size: 12.5px;
  }

  .linea b {
    font-weight: 500;
  }

  .linea .mono {
    font-size: 11px;
    color: var(--foreground-muted);
    text-align: right;
  }

  .pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    /* deja sitio al botón de repetir */
    padding-right: 52px;
    border-top: 1px solid var(--line);
    background: var(--surface-secondary);
    font-size: 12.5px;
    color: var(--foreground-muted);
  }

  .reloj {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--foreground);
  }

  .reloj svg {
    width: 16px;
    height: 16px;
    color: var(--foreground-muted);
  }
</style>
