---
/**
 * Sistema de avisos: lo que Crisopa para antes de que llegue al cuaderno o a
 * una inspección. Los dos errores salen de las fichas del MAPA ya
 * comprobadas para el hero (Score 25 EC nº 18767, máx. 0,45 l/ha en almendro;
 * Karate Zeon nº 22398, 1 aplicación por campaña). El primero tiembla una vez.
 */
import Escena from './Escena.astro'

const avisos = [
  {
    tipo: 'error',
    titulo: 'Dosis por encima del máximo',
    texto: 'Score 25 EC en Guara a 0,60 l/ha. En almendro, el máximo es 0,45 l/ha.',
    fuente: 'Ficha MAPA · Nº 18767',
  },
  {
    tipo: 'error',
    titulo: 'No se puede repetir',
    texto: 'Karate Zeon admite 1 aplicación por campaña y Almendros Lauranne ya la tiene.',
    fuente: 'Ficha MAPA · Nº 22398',
  },
  {
    tipo: 'warn',
    titulo: 'Carné ROPO por caducar',
    texto: 'El de A. Ruiz caduca en 42 días.',
  },
  {
    tipo: 'warn',
    titulo: 'Inspección del atomizador',
    texto: 'Caduca en 58 días.',
  },
]
---

<Escena class="fn-avisos" label="Avisos de Crisopa: una dosis por encima del máximo, una aplicación que no se puede repetir, un carné ROPO y una inspección por caducar.">
  <div class="win">
    <div class="win-bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url">Avisos · Los Llanos · campaña 2027</span>
    </div>
    <ul class="lista">
      {avisos.map((a, i) => (
        <li class="st" style={`--d: ${i * 350}ms`}>
          <div class:list={['aviso', a.tipo, i === 0 && 'tiembla']}>
            <span class="ico" aria-hidden="true">{a.tipo === 'error' ? '✕' : '!'}</span>
            <div>
              <p class="t">{a.titulo}</p>
              <p class="x">{a.texto}</p>
              {a.fuente && <p class="src">{a.fuente}</p>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Escena>

<style>
  .lista {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 16px;
    list-style: none;
  }

  .aviso {
    display: flex;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid;
    border-radius: var(--radius-md);
  }

  .aviso p {
    margin: 0;
  }

  .warn {
    border-color: oklch(from var(--state-warning) 0.87 0.08 h);
    background: oklch(from var(--state-warning) 0.98 0.02 h);
  }

  .aviso.error {
    border-color: oklch(from var(--state-error) 0.85 0.08 h);
    background: oklch(from var(--state-error) 0.975 0.015 h);
  }

  .ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: white;
    background: oklch(from var(--state-warning) 0.66 0.15 h);
  }

  .error .ico {
    background: var(--state-error);
  }

  .t {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: oklch(from var(--state-warning) 0.48 0.12 h);
  }

  .error .t {
    color: var(--state-error);
  }

  .x {
    margin-top: 3px !important;
    font-size: 13px;
  }

  .src {
    margin-top: 4px !important;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--foreground-muted);
  }

  :global(.run) .tiembla {
    animation: esc-tiembla 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) 500ms;
  }
</style>
