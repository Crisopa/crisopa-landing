---
const calendlyUrl = 'https://calendly.com/demo-crisopa/30min'
---

<section class="relative py-16 sm:py-24 lg:py-32 overflow-hidden bg-dark-background">

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center" data-animate>
    <!-- Logo -->
    <div class="flex justify-center mb-6">
      <svg
        class="h-16 w-16 sm:h-20 sm:w-20 text-primary-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M11.264 2.205A4 4 0 0 0 6.42 4.211l-4 8a4 4 0 0 0 1.359 5.117l6 4a4 4 0 0 0 4.438 0l6-4a4 4 0 0 0 1.576-4.592l-2-6a4 4 0 0 0-2.53-2.53z"/>
        <path d="M11.99 22 14 12l7.822 3.184"/>
        <path d="M14 12 8.47 2.302"/>
      </svg>
    </div>

    <!-- Brand name -->
    <h2 class="text-3xl sm:text-5xl lg:text-6xl text-dark-foreground">
      crisopa
    </h2>

    <!-- Tagline -->
    <p class="mt-6 text-lg sm:text-xl text-dark-foreground-muted">
      El copiloto agronómico
      <span class="font-semibold text-dark-foreground"> hecho para el campo español.</span>
    </p>

    <!-- CTA Button -->
    <div class="mt-10">
      <a
        href={calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-press
        class="group inline-flex items-center justify-center rounded-md bg-primary-400 px-8 py-4 text-base font-medium text-dark-background hover:bg-primary-500"
      >
        Reservar demo
        <svg class="ml-2 h-5 w-5 transition-transform duration-150 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <!-- Trust badges -->
    <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-sm text-dark-foreground-muted">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Demo en 30 min</span>
      </div>
      <div class="hidden sm:block w-px h-4 bg-dark-line"></div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Sin compromiso</span>
      </div>
      <div class="hidden sm:block w-px h-4 bg-dark-line"></div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Online</span>
      </div>
    </div>
  </div>
</section>
