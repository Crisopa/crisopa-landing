---
const calendlyUrl = 'https://calendly.com/demo-crisopa/30min'

const plans = [
  {
    name: 'Profesional',
    description: 'Para el técnico de tu finca',
    price: { monthly: 49, yearly: 588 },
    features: [
      'Hasta 10 explotaciones',
      '1 usuario',
      'Copiloto IA (ChatGPT y Claude)',
      'Tratamientos y fertilización',
      'Informes PDF para inspección',
      'Soporte por email',
    ],
    notIncluded: [],
    cta: 'Reservar demo',
    popular: false,
  },
  {
    name: 'Asesor',
    description: 'Para equipos y carteras de fincas',
    price: { monthly: 99, yearly: 1188 },
    features: [
      'Multiusuario con permisos por finca',
      'Gestión multicliente',
      'Copiloto IA (ChatGPT y Claude)',
      'Tratamientos y fertilización',
      'Informes PDF para inspección',
      'Soporte prioritario',
      'Hasta 100 explotaciones',
    ],
    notIncluded: [],
    cta: 'Reservar demo',
    popular: true,
  },
  {
    name: 'Enterprise',
    description: 'Cooperativas y grandes organizaciones',
    price: null,
    features: [
      'Todo lo del plan Asesor',
      'Volumen a medida',
      'Integración con tu ERP',
      'Acompañamiento en la implantación',
      'Gestor de cuenta dedicado',
    ],
    notIncluded: [],
    cta: 'Contactar con ventas',
    popular: false,
  },
]
---

<section id="precios" class="relative py-16 sm:py-24 lg:py-32 bg-background overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto" data-animate>
      <span class="inline-block font-data text-xs font-medium uppercase tracking-[0.18em] text-primary-700">
        Precios<span class="eyebrow-caret"></span>
      </span>
      <h2 class="mt-6 font-display text-[2rem] text-foreground sm:text-[2.5rem] lg:text-5xl">
        Precios claros
      </h2>
      <p class="mt-6 text-lg text-foreground-muted leading-relaxed">
        Reserva una demo de 30 min y te enseñamos cómo encaja en tu día a día.
      </p>
    </div>

    <!-- Pricing cards -->
    <div class="mt-10 sm:mt-16 grid gap-6 sm:gap-8 lg:grid-cols-3">
      {plans.map((plan, index) => (
        <div
          class="relative"
          data-animate
          style={`transition-delay: ${index * 60}ms;`}
        >
          <div class={`relative h-full rounded-lg bg-surface p-6 sm:p-8 shadow-1 border ${plan.popular ? 'border-primary-600' : 'border-line-strong'}`}>
            {/* Popular badge */}
            {plan.popular && (
              <div class="absolute -top-5 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-600 px-5 py-2 text-sm font-medium text-white">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  Popular
                </span>
              </div>
            )}

            {/* Plan header */}
            <div class="text-center pt-4">
              <h3 class="font-display text-xl text-foreground">{plan.name}</h3>
              <p class="mt-2 text-sm text-foreground-muted">{plan.description}</p>

              {/* Price */}
              {plan.price ? (
                <div class="mt-8">
                  <div class="flex items-baseline justify-center">
                    <span class="font-data text-4xl sm:text-5xl font-medium tabular-nums text-foreground">
                      {plan.price.monthly}
                    </span>
                    <span class="ml-1 text-xl sm:text-2xl font-medium text-foreground-muted">€</span>
                    <span class="ml-2 text-base font-medium text-foreground-muted">/mes</span>
                  </div>
                  <p class="mt-2 text-sm text-foreground-muted">
                    <span class="font-data">{plan.price.yearly}€/año</span> · se factura una vez al año
                  </p>
                </div>
              ) : (
                <div class="mt-8">
                  <span class="font-display text-3xl sm:text-4xl font-semibold tracking-[-0.03em] text-foreground">A medida</span>
                  <p class="mt-2 text-sm text-foreground-muted">Adaptado a tu organización</p>
                </div>
              )}
            </div>

            {/* CTA */}
            <div class="mt-8">
              <a
                href={plan.price ? calendlyUrl : '#contacto'}
                target={plan.price ? '_blank' : undefined}
                rel={plan.price ? 'noopener noreferrer' : undefined}
                data-press
                class={`block w-full rounded-md py-4 px-6 text-center text-base font-medium ${
                  plan.popular
                    ? 'bg-primary-600 text-white hover:bg-primary-700'
                    : 'border border-line-strong bg-surface text-foreground hover:bg-surface-secondary'
                }`}
              >
                {plan.cta}
              </a>
            </div>

            {/* Divider */}
            <div class="my-8 h-px bg-line"></div>

            {/* Features */}
            <ul class="space-y-4">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <div class={`flex-shrink-0 mt-0.5 w-5 h-5 rounded-full flex items-center justify-center ${plan.popular ? 'bg-primary-100' : 'bg-surface-secondary'}`}>
                    <svg class={`h-3 w-3 ${plan.popular ? 'text-primary-700' : 'text-foreground-muted'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-sm text-foreground-muted">{feature}</span>
                </li>
              ))}
              {plan.notIncluded.map((feature) => (
                <li class="flex items-start gap-3 opacity-40">
                  <div class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-surface-secondary flex items-center justify-center">
                    <svg class="h-3 w-3 text-foreground-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </div>
                  <span class="text-sm text-foreground-muted">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    {/* Garantía */}
    <div class="mt-16 text-center" data-animate>
      <div class="inline-flex items-center gap-3 rounded-lg bg-surface border border-line-strong px-6 py-4 shadow-1">
        <div class="flex items-center justify-center w-10 h-10 rounded-md border border-line bg-surface-secondary">
          <svg class="w-5 h-5 text-primary-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <p class="text-sm text-foreground-muted">
          <span class="font-semibold text-foreground">Sin permanencia.</span> Cancelas cuando quieras.
        </p>
      </div>
    </div>
  </div>
</section>
